module

public import GroupRings.MonoidAlgebra.MonomialSubalgebra
public import Mathlib.Algebra.Group.Submonoid.Operations

/-!
# Subalgebras generated by additive monomials

The standard equivalence `AddMonoidAlgebra.toMultiplicativeAlgEquiv` identifies
additive monomial adjoins with the multiplicative monomial subalgebras. Their
membership condition is containment of coefficient support in the exponent
submonoid. The coefficient semiring may be trivial, and the additive monoid
need not be commutative or cancellative.

## References

* Mathlib's monoid-algebra equivalences and supported modules, by Johannes Hölzl,
  Yury Kudryashov, and Kim Morrison.
* Mathlib's subalgebra and adjoining API, by Kenny Lau and Yury Kudryashov.
* The monomial support characterization in
  `ToricIdeals.MvPolynomial.MonomialSubalgebra`, generalized to monoid algebras.
-/

@[expose] public section

namespace AddMonoidAlgebra

universe u v

variable {R : Type u} {N : Type v} [CommSemiring R] [AddMonoid N]

/-- The additive monomial adjoin maps to the corresponding multiplicative
monomial subalgebra under the standard change of exponent notation. -/
theorem map_adjoin_single_eq_monomialSubalgebra (S : AddSubmonoid N) :
    (Algebra.adjoin R (Set.range fun s : S => single (s : N) (1 : R))).map
        (toMultiplicativeAlgEquiv R R N).toAlgHom =
      MonoidAlgebra.monomialSubalgebra R S.toSubmonoid := by
  rw [AlgHom.map_adjoin, MonoidAlgebra.monomialSubalgebra_eq_adjoin]
  congr 1
  ext p
  constructor
  · rintro ⟨_, ⟨s, rfl⟩, rfl⟩
    exact ⟨⟨Multiplicative.ofAdd (s : N), s.property⟩,
      (toMultiplicativeAlgEquiv_single (R := R) (A := R) (s : N) 1).symm⟩
  · rintro ⟨s, rfl⟩
    refine ⟨single (Multiplicative.toAdd (s : Multiplicative N)) (1 : R),
      ⟨⟨Multiplicative.toAdd (s : Multiplicative N), s.property⟩, rfl⟩, ?_⟩
    exact toMultiplicativeAlgEquiv_single _ _

/-- The additive monomial adjoin is the inverse image of the multiplicative
monomial subalgebra. -/
theorem adjoin_single_eq_comap_monomialSubalgebra (S : AddSubmonoid N) :
    Algebra.adjoin R (Set.range fun s : S => single (s : N) (1 : R)) =
      (MonoidAlgebra.monomialSubalgebra R S.toSubmonoid).comap
        (toMultiplicativeAlgEquiv R R N).toAlgHom := by
  rw [← map_adjoin_single_eq_monomialSubalgebra,
    Subalgebra.comap_map_eq_self_of_injective
      (toMultiplicativeAlgEquiv R R N).injective]

/-- Changing additive exponents to multiplicative exponents preserves each
coefficient. -/
theorem coeff_toMultiplicativeAlgEquiv (p : AddMonoidAlgebra R N) (n : N) :
    ((toMultiplicativeAlgEquiv R R N) p).coeff (Multiplicative.ofAdd n) = p.coeff n := by
  simp [toMultiplicativeAlgEquiv, toMultiplicative]

/-- Membership in the additive monomial adjoin is the generic supported-module
condition, expressed using additive exponents. -/
theorem mem_adjoin_single_iff (S : AddSubmonoid N) (p : AddMonoidAlgebra R N) :
    p ∈ Algebra.adjoin R (Set.range fun s : S => single (s : N) (1 : R)) ↔
      (↑p.coeff.support : Set N) ⊆ S := by
  rw [adjoin_single_eq_comap_monomialSubalgebra]
  change (toMultiplicativeAlgEquiv R R N) p ∈
    MonoidAlgebra.monomialSubalgebra R S.toSubmonoid ↔ _
  rw [MonoidAlgebra.mem_monomialSubalgebra_iff]
  constructor
  · intro hp n hn
    have hn' : Multiplicative.ofAdd n ∈
        ((toMultiplicativeAlgEquiv R R N) p).coeff.support := by
      apply Finsupp.mem_support_iff.mpr
      rw [coeff_toMultiplicativeAlgEquiv p n]
      exact Finsupp.mem_support_iff.mp (Finset.mem_coe.mp hn)
    exact hp (Finset.mem_coe.mpr hn')
  · intro hp n hn
    have hn' : Multiplicative.toAdd n ∈ p.coeff.support := by
      apply Finsupp.mem_support_iff.mpr
      rw [← coeff_toMultiplicativeAlgEquiv p (Multiplicative.toAdd n)]
      exact Finsupp.mem_support_iff.mp (Finset.mem_coe.mp hn)
    exact hp (Finset.mem_coe.mpr hn')

/-- A single additive monomial belongs to the adjoin exactly when its exponent
belongs to the submonoid or its coefficient vanishes. -/
@[simp]
theorem single_mem_adjoin_single_iff (S : AddSubmonoid N) (n : N) (r : R) :
    single n r ∈ Algebra.adjoin R (Set.range fun s : S => single (s : N) (1 : R)) ↔
      n ∈ S ∨ r = 0 := by
  rw [adjoin_single_eq_comap_monomialSubalgebra]
  change (toMultiplicativeAlgEquiv R R N) (single n r) ∈
    MonoidAlgebra.monomialSubalgebra R S.toSubmonoid ↔ _
  rw [toMultiplicativeAlgEquiv_single,
    MonoidAlgebra.single_mem_monomialSubalgebra_iff]
  rfl

/-- Inclusion of additive exponent submonoids induces inclusion of their
coefficient-one monomial adjoins. -/
theorem adjoin_single_mono {S T : AddSubmonoid N} (hST : S ≤ T) :
    Algebra.adjoin R (Set.range fun s : S => single (s : N) (1 : R)) ≤
      Algebra.adjoin R (Set.range fun t : T => single (t : N) (1 : R)) := by
  apply Algebra.adjoin_mono
  rintro _ ⟨s, rfl⟩
  exact ⟨⟨s, hST s.property⟩, rfl⟩

end AddMonoidAlgebra
