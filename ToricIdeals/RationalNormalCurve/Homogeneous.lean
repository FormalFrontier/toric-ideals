module

public import Mathlib.RingTheory.MvPolynomial.Homogeneous
public import ToricIdeals.RationalNormalCurve

/-!
# Standard homogeneity of Hankel ideals

The ideal generated by the rational-normal-curve Hankel minors is homogeneous
for the standard natural-number grading of the source polynomial ring, over
any commutative coefficient ring and for every `n`.

## Implementation notes

The grading is Mathlib's `MvPolynomial.homogeneousSubmodule`, with the existing
`MvPolynomial.gradedAlgebra` selected locally. At `n = 0` the source has one
variable and the Hankel ideal is `⊥`; at `n = 1` it has two variables and the
ideal is again `⊥`. The degree-zero ideal is not replaced by the parametrization
kernel or image. Each displayed minor has homogeneous degree label `2`, which
does not assert total degree `2` for a zero polynomial. No grading on the
quotient or Hilbert-function computation is defined here.

## References

* Ravi Vakil, *The Rising Sea: Foundations of Algebraic Geometry*, October 21,
  2025 draft, Exercise 3.6.F, motivates the Hankel presentation used here.
* Formal Frontier Agents, `ToricIdeals.RationalNormalCurve`, supplies the source
  polynomial ring, ordered minors, ideal and small-degree boundary results.
* Mathlib contributors, `Mathlib.RingTheory.MvPolynomial.Homogeneous` and
  `Mathlib.RingTheory.GradedAlgebra.Homogeneous.Ideal`, supply the standard
  polynomial grading and homogeneous-ideal predicates and operations.
-/

@[expose] public section

universe u

namespace ToricIdeals.RationalNormalCurve

attribute [local instance] MvPolynomial.gradedAlgebra

/-- The Hankel-minor ideal is homogeneous for the standard source grading,
over any commutative coefficient ring and for every `n`, including `0` and `1`.
This concerns the Hankel presentation from `ToricIdeals.RationalNormalCurve`,
motivated by Vakil's *The Rising Sea*, Exercise 3.6.F, and uses Mathlib's
`Ideal.IsHomogeneous`. It requires neither nontriviality nor a domain, field,
reducedness or positive-degree hypothesis. -/
theorem hankelIdeal_isHomogeneous (R : Type u) [CommRing R] (n : ℕ) :
    Ideal.IsHomogeneous (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R)
      (hankelIdeal R n) := by
  rw [hankelIdeal]
  apply Ideal.homogeneous_span (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R)
  rintro _ ⟨p, rfl⟩
  refine ⟨2, ?_⟩
  rw [MvPolynomial.mem_homogeneousSubmodule, hankelMinor]
  exact ((MvPolynomial.isHomogeneous_X R p.1.1.castSucc).mul
      (MvPolynomial.isHomogeneous_X R p.1.2.succ)).sub
    ((MvPolynomial.isHomogeneous_X R p.1.1.succ).mul
      (MvPolynomial.isHomogeneous_X R p.1.2.castSucc))

end ToricIdeals.RationalNormalCurve
