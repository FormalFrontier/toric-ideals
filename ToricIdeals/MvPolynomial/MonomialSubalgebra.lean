module

public import Mathlib.RingTheory.MvPolynomial.Basic

/-!
# Subalgebras generated by multivariate monomials

For an additive submonoid `S` of `σ →₀ ℕ`, the existing subalgebra
`Algebra.adjoin R (Set.range fun s : S => monomial (s : σ →₀ ℕ) 1)`
consists exactly of polynomials whose coefficient support is contained in `S`.
No finiteness assumption on the variables or the submonoid is needed, and the
coefficient semiring may be trivial. A monic monomial detects exponent membership
when the coefficient semiring is nontrivial.

The subalgebra's underlying module is `MvPolynomial.restrictSupport`. The proof
combines Mathlib's linear-span characterizations of `Algebra.adjoin` and
`restrictSupport`.

## References

* Mathlib's subalgebra lattice and adjoining API, by Kenny Lau and Yury Kudryashov.
* Mathlib's multivariate polynomial and restricted-support API, by Johannes Hölzl,
  Johan Commelin, and Mario Carneiro.
-/

@[expose] public section

namespace MvPolynomial

universe u v

variable {R : Type u} {σ : Type v} [CommSemiring R]

/-- The underlying module of the subalgebra generated by `S`-monomials is the
module of polynomials supported on `S`. The coefficient semiring may be
trivial, and the variables and additive submonoid may be infinite. -/
theorem adjoin_monomial_toSubmodule (S : AddSubmonoid (σ →₀ ℕ)) :
    (Algebra.adjoin R
      (Set.range fun s : S => monomial (s : σ →₀ ℕ) (1 : R))).toSubmodule =
        restrictSupport R (S : Set (σ →₀ ℕ)) := by
  rw [restrictSupport_eq_span, Set.image_eq_range]
  apply Algebra.adjoin_eq_span_of_subset
  intro p hp
  apply Submodule.subset_span
  refine Submonoid.closure_induction ?_ ?_ ?_ hp
  · intro x hx
    exact hx
  · exact ⟨⟨0, S.zero_mem⟩, one_def.symm⟩
  · rintro x y hx hy ⟨s, rfl⟩ ⟨t, rfl⟩
    exact ⟨s + t, by simp only [AddSubmonoid.coe_add, monomial_mul_monomial, mul_one]⟩

/-- Membership in the subalgebra generated by `S`-monomials means that every
exponent with nonzero coefficient belongs to `S`. -/
theorem mem_adjoin_monomial_iff (S : AddSubmonoid (σ →₀ ℕ))
    (p : MvPolynomial σ R) :
    p ∈ Algebra.adjoin R
      (Set.range fun s : S => monomial (s : σ →₀ ℕ) (1 : R)) ↔
        (↑p.support : Set (σ →₀ ℕ)) ⊆ S := by
  rw [← Subalgebra.mem_toSubmodule, adjoin_monomial_toSubmodule, mem_restrictSupport_iff]

/-- A monomial belongs to the subalgebra generated by `S`-monomials exactly
when its exponent belongs to `S` or its coefficient vanishes. This includes the
zero coefficient semiring; for a nonzero coefficient it detects the exponent. -/
@[simp]
theorem monomial_mem_adjoin_monomial_iff
    (S : AddSubmonoid (σ →₀ ℕ)) (n : σ →₀ ℕ) (r : R) :
    monomial n r ∈ Algebra.adjoin R
      (Set.range fun s : S => monomial (s : σ →₀ ℕ) (1 : R)) ↔ n ∈ S ∨ r = 0 := by
  rw [← Subalgebra.mem_toSubmodule, adjoin_monomial_toSubmodule,
    monomial_mem_restrictSupport, SetLike.mem_coe]

end MvPolynomial
