module

public import Mathlib.Algebra.Algebra.Subalgebra.Tower
public import ToricIdeals.MvPolynomial.MonomialIntegralClosure
import ToricIdeals.MvPolynomial.MonomialCosetSupport
import MultivariatePolynomials.IntegrallyClosed

/-!
# Normalization images of multivariate monomial subalgebras

Over an integrally closed commutative domain, the normalization of the subalgebra
of `S`-monomials has polynomial image generated by the monomials whose exponent
is both a difference of elements of `S` and a root of a positive multiple in `S`.
The normalization is taken in the subalgebra's own fraction field. The comparison
uses the canonical fraction-field embedding induced by polynomial inclusion.

The difference condition is essential: even exponents still give the even-exponent
subalgebra, not the full polynomial algebra. The variable type may be empty or
infinite, and the exponent submonoid need not be finitely generated. Variables and
coefficients have independent universes.

## References

* The fine-component integrality and relative support arguments in
  `ToricIdeals.MvPolynomial.MonomialIntegralClosure` and
  `ToricIdeals.MvPolynomial.MonomialCosetSupport` supply the two exponent conditions.
* Mathlib's fraction-ring lift, by Kenny Lau, Mario Carneiro, Johan Commelin,
  Amelia Livingston and Anne Baanen, supplies the canonical comparison. Kenny Lau's
  integral closure and the subalgebra/adjoin API by Kenny Lau and Yury Kudryashov
  supply the closure membership and universal property.
* `MultivariatePolynomials.IntegrallyClosed`, following Stacks Project Tag 030A,
  supplies normality of the ambient polynomial ring.
-/

@[expose] public section

namespace MvPolynomial

universe u v

variable {R : Type u} {σ : Type v} [CommRing R] [IsDomain R] [IsIntegrallyClosed R]

/-- The image of a monomial subalgebra's integral closure in its own fraction
field is generated by the monomials whose exponents are differences of admissible
exponents and have a positive multiple in the original submonoid. The scalar
structures are the canonical coefficient and localization structures, and the map is
the canonical lift of polynomial inclusion. -/
theorem map_integralClosure_adjoin_monomial (S : AddSubmonoid (σ →₀ ℕ)) :
    let P := MvPolynomial σ R
    let A := Algebra.adjoin R
      (Set.range fun s : S => monomial (s : σ →₀ ℕ) (1 : R))
    let B := Algebra.adjoin R
      (Set.range fun n : {n : σ →₀ ℕ //
        (∃ b, b ∈ S ∧ b + n ∈ S) ∧ ∃ k : ℕ, 0 < k ∧ k • n ∈ S} =>
          monomial n.val (1 : R))
    let ιP := IsScalarTower.toAlgHom R P (FractionRing P)
    let θ := IsFractionRing.liftAlgHom (K := FractionRing A) (g := ιP.comp A.val)
      ((IsFractionRing.injective P (FractionRing P)).comp Subtype.val_injective)
    ((integralClosure A (FractionRing A)).restrictScalars R).map θ = B.map ιP := by
  classical
  let P := MvPolynomial σ R
  let A := Algebra.adjoin R
    (Set.range fun s : S => monomial (s : σ →₀ ℕ) (1 : R))
  let B := Algebra.adjoin R
    (Set.range fun n : {n : σ →₀ ℕ //
      (∃ b, b ∈ S ∧ b + n ∈ S) ∧ ∃ k : ℕ, 0 < k ∧ k • n ∈ S} =>
        monomial n.val (1 : R))
  let FA := FractionRing A
  let FP := FractionRing P
  let ιP := IsScalarTower.toAlgHom R P FP
  let θ := IsFractionRing.liftAlgHom (K := FA) (g := ιP.comp A.val)
    ((IsFractionRing.injective P FP).comp Subtype.val_injective)
  let D := ((integralClosure A FA).restrictScalars R).map θ
  change D = B.map ιP
  have hθ (a : A) : θ (algebraMap A FA a) = algebraMap P FP (a : P) := by
    exact (IsFractionRing.liftAlgHom_apply (R := R) (A := A) (K := FA)
      (g := ιP.comp A.val)
      ((IsFractionRing.injective P FP).comp Subtype.val_injective)
      (algebraMap A FA a)).trans
        (IsFractionRing.lift_algebraMap (A := A) (K := FA)
          (g := (ιP.comp A.val).toRingHom)
          ((IsFractionRing.injective P FP).comp Subtype.val_injective) a)
  have hθcomp : (algebraMap A FP).comp (RingHom.id A) =
      θ.toRingHom.comp (algebraMap A FA) := by
    ext a
    change algebraMap P FP (a : P) = θ (algebraMap A FA a)
    exact (hθ a).symm
  apply le_antisymm
  · rintro y ⟨x, hx, rfl⟩
    change IsIntegral A x at hx
    have hxA : IsIntegral A (θ x) := hx.map_of_comp_eq (RingHom.id A) θ.toRingHom hθcomp
    obtain ⟨p, hp⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral
      (hxA.tower_top : IsIntegral P (θ x))
    have hpint : IsIntegral A p := by
      apply (isIntegral_algHom_iff (IsScalarTower.toAlgHom A P FP)
        (IsFractionRing.injective P FP)).mp
      change IsIntegral A (algebraMap P FP p)
      rw [hp]
      exact hxA
    have hpB : p ∈ B := by
      obtain ⟨a, b, hb, hx⟩ := IsFractionRing.div_surjective A x
      have hbP : (b : P) ≠ 0 := by
        intro h
        exact nonZeroDivisors.ne_zero hb (Subtype.ext h)
      have hbF : algebraMap P FP (b : P) ≠ 0 := by
        simpa only [map_zero] using (IsFractionRing.injective P FP).ne hbP
      have hbp : (b : P) * p = (a : P) := by
        apply IsFractionRing.injective P FP
        rw [map_mul, hp, ← hx, map_div₀, hθ, hθ]
        exact mul_div_cancel₀ _ hbF
      rw [← support_sum_monomial_coeff p]
      apply B.sum_mem
      intro n hn
      obtain ⟨s, hs, hsn⟩ := exists_mem_add_mem_of_mul_mem_adjoin_monomial S
        b.property (fun _ _ h => mul_left_cancel₀ hbP h)
        (by rw [hbp]; exact a.property) hn
      obtain ⟨k, hk, hkn⟩ := exists_pos_nsmul_mem_of_isIntegral_of_mem_support S hpint hn
      have hm : monomial n (1 : R) ∈ B :=
        Algebra.subset_adjoin ⟨⟨n, ⟨⟨s, hs, hsn⟩, k, hk, hkn⟩⟩, rfl⟩
      have heq : monomial n (p.coeff n) = C (p.coeff n) * monomial n (1 : R) := by
        rw [C_mul_monomial, mul_one]
      rw [heq]
      exact B.mul_mem (B.algebraMap_mem _) hm
    exact ⟨p, hpB, hp⟩
  · have hB : B ≤ D.comap ιP := by
      apply Algebra.adjoin_le
      rintro _ ⟨⟨n, ⟨⟨b, hb, hbn⟩, k, hk, hkn⟩⟩, rfl⟩
      let a : A := ⟨monomial b 1, Algebra.subset_adjoin ⟨⟨b, hb⟩, rfl⟩⟩
      let c : A := ⟨monomial (b + n) 1,
        Algebra.subset_adjoin ⟨⟨b + n, hbn⟩, rfl⟩⟩
      let d : A := ⟨monomial (k • n) 1,
        Algebra.subset_adjoin ⟨⟨k • n, hkn⟩, rfl⟩⟩
      let x : FA := algebraMap A FA c / algebraMap A FA a
      have haF : algebraMap P FP (a : P) ≠ 0 := by
        have haP : (a : P) ≠ 0 := by simp [a]
        simpa only [map_zero] using (IsFractionRing.injective P FP).ne haP
      have hθx : θ x = ιP (monomial n 1) := by
        change θ (algebraMap A FA c / algebraMap A FA a) =
          algebraMap P FP (monomial n 1)
        rw [map_div₀, hθ, hθ]
        apply (div_eq_iff haF).mpr
        rw [← map_mul]
        apply congrArg (algebraMap P FP)
        change monomial (b + n) (1 : R) = monomial n 1 * monomial b 1
        simp [add_comm]
      have hpow : x ^ k = algebraMap A FA d := by
        apply (show Function.Injective θ from θ.injective)
        calc
          θ (x ^ k) = θ x ^ k := map_pow θ x k
          _ = ιP (monomial n 1) ^ k := congrArg (fun z : FP => z ^ k) hθx
          _ = ιP (monomial (k • n) 1) := by
            rw [← map_pow, monomial_pow, one_pow]
          _ = θ (algebraMap A FA d) := (hθ d).symm
      have hxint : IsIntegral A x := IsIntegral.of_pow hk (by
        rw [hpow]
        exact isIntegral_algebraMap)
      exact ⟨x, hxint, hθx⟩
    rintro y ⟨p, hp, rfl⟩
    exact hB hp

end MvPolynomial
