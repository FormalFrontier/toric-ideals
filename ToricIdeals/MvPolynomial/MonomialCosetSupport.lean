module

public import Mathlib.Algebra.MonoidAlgebra.Grading
public import Mathlib.Algebra.Regular.Defs
public import Mathlib.GroupTheory.QuotientGroup.Defs
public import ToricIdeals.MvPolynomial.MonomialSubalgebra

/-!
# Coset support under a regular monomial-subalgebra denominator

Let `S` be an additive submonoid of the natural exponent vectors. If `b` belongs
to the standard monomial adjoin, is left-regular in the ambient polynomial algebra,
and `b * f` belongs to that adjoin, then the integer exponent vector of every term
of `f` belongs to the additive subgroup generated by `S`.

The denominator is an arbitrary polynomial in the adjoin. The proof uses the
existing `AddMonoidAlgebra.gradeBy` grading by the quotient of the integer
exponent group, and composes its stock zero-component laws directly. The degree
group may have torsion. Neither a coefficient-domain assumption nor any finiteness
assumption is needed. This is a support lemma, not a normality criterion.

## References

* Eric Wieser's `Mathlib.Algebra.MonoidAlgebra.Grading` supplies the
  `AddMonoidAlgebra.gradeBy` construction used for the quotient grading.
* `Mathlib.RingTheory.GradedAlgebra.Basic`, by Eric Wieser, Kevin Buzzard,
  Jujian Zhang, and Fangming Li, supplies the degree-zero `DirectSum`
  multiplication and projection laws used in the proof.
* `Mathlib.Algebra.Algebra.Subalgebra.Lattice`, by Kenny Lau and Yury Kudryashov,
  supplies the induction principle for the algebra generated by a set.
* `ToricIdeals.MvPolynomial.MonomialSubalgebra`, by Formal Frontier Agents,
  supplies the standard monomial-adjoin model.
-/

@[expose] public section

namespace MvPolynomial

universe u v

variable {R : Type u} {σ : Type v} [CommSemiring R]

/-- An ambient left-regular denominator in the standard monomial adjoin forces
all exponents of the numerator into the group generated by the adjoin's exponent
monoid. It does not force those exponents into the monoid itself. -/
theorem support_subset_groupClosure_of_mul_mem_adjoin_monomial
    (S : AddSubmonoid (σ →₀ ℕ)) {b f : MvPolynomial σ R}
    (hb : b ∈ Algebra.adjoin R
      (Set.range fun s : S => monomial (s : σ →₀ ℕ) (1 : R)))
    (hbreg : IsLeftRegular b)
    (hbf : b * f ∈ Algebra.adjoin R
      (Set.range fun s : S => monomial (s : σ →₀ ℕ) (1 : R))) :
    ∀ n ∈ f.support,
      (Finsupp.mapRange.addMonoidHom (Nat.castAddMonoidHom ℤ)) n ∈
        AddSubgroup.closure
          ((Finsupp.mapRange.addMonoidHom (Nat.castAddMonoidHom ℤ)) ''
            (S : Set (σ →₀ ℕ))) := by
  classical
  let e : (σ →₀ ℕ) →+ (σ →₀ ℤ) :=
    Finsupp.mapRange.addMonoidHom (Nat.castAddMonoidHom ℤ)
  let H : AddSubgroup (σ →₀ ℤ) := AddSubgroup.closure (e '' (S : Set (σ →₀ ℕ)))
  let d : (σ →₀ ℕ) →+ ((σ →₀ ℤ) ⧸ H) := (QuotientAddGroup.mk' H).comp e
  let 𝒜 := AddMonoidAlgebra.gradeBy R d
  have mem_zero {p : MvPolynomial σ R}
      (hp : p ∈ Algebra.adjoin R
        (Set.range fun s : S => monomial (s : σ →₀ ℕ) (1 : R))) : p ∈ 𝒜 0 := by
    refine Algebra.adjoin_induction (p := fun p _ => p ∈ 𝒜 0) ?_ ?_ ?_ ?_ hp
    · rintro _ ⟨s, rfl⟩
      have hs0 : d (s : σ →₀ ℕ) = 0 :=
        (QuotientAddGroup.eq_zero_iff _).2
          (AddSubgroup.subset_closure ⟨s, s.property, rfl⟩)
      change AddMonoidAlgebra.single (s : σ →₀ ℕ) (1 : R) ∈
        AddMonoidAlgebra.gradeBy R d 0
      rw [← hs0]
      exact AddMonoidAlgebra.single_mem_gradeBy d _ _
    · intro r
      change AddMonoidAlgebra.single (0 : σ →₀ ℕ) r ∈ AddMonoidAlgebra.gradeBy R d 0
      simpa only [map_zero] using AddMonoidAlgebra.single_mem_gradeBy d 0 r
    · intro p q _ _ hp hq
      exact (𝒜 0).add_mem hp hq
    · intro p q _ _ hp hq
      simpa only [zero_add] using SetLike.mul_mem_graded hp hq
  have hb0 : b ∈ 𝒜 0 := mem_zero hb
  have hbf0 : b * f ∈ 𝒜 0 := mem_zero hbf
  have hf_eq : ((DirectSum.decompose 𝒜 f) 0 : MvPolynomial σ R) = f := by
    exact hbreg <|
      (DirectSum.coe_decompose_mul_of_left_mem_zero 𝒜 (j := 0) (b := f) hb0).symm.trans
        (DirectSum.decompose_of_mem_same 𝒜 hbf0)
  have hf0 : f ∈ 𝒜 0 := by
    rw [← hf_eq]
    exact ((DirectSum.decompose 𝒜 f) 0).property
  intro n hn
  change e n ∈ H
  exact (QuotientAddGroup.eq_zero_iff (e n)).1 (hf0 n hn)

/-- Under a regular denominator from a monomial subalgebra, every support exponent
of the quotient is a difference of two exponents in the defining submonoid. -/
theorem exists_mem_add_mem_of_mul_mem_adjoin_monomial
    (S : AddSubmonoid (σ →₀ ℕ)) {b f : MvPolynomial σ R}
    (hb : b ∈ Algebra.adjoin R
      (Set.range fun s : S => monomial (s : σ →₀ ℕ) (1 : R)))
    (hbreg : IsLeftRegular b)
    (hbf : b * f ∈ Algebra.adjoin R
      (Set.range fun s : S => monomial (s : σ →₀ ℕ) (1 : R)))
    {n : σ →₀ ℕ} (hn : n ∈ f.support) : ∃ s ∈ S, s + n ∈ S := by
  let e : (σ →₀ ℕ) →+ (σ →₀ ℤ) :=
    Finsupp.mapRange.addMonoidHom (Nat.castAddMonoidHom ℤ)
  have hdiff (z : σ →₀ ℤ)
      (hz : z ∈ AddSubgroup.closure (e '' (S : Set (σ →₀ ℕ)))) :
      ∃ s ∈ S, ∃ t ∈ S, z + e s = e t := by
    induction hz using AddSubgroup.closure_induction with
    | mem z hz =>
      obtain ⟨t, ht, rfl⟩ := hz
      exact ⟨0, S.zero_mem, t, ht, by simp⟩
    | zero => exact ⟨0, S.zero_mem, 0, S.zero_mem, by simp⟩
    | add z w _ _ hz hw =>
      obtain ⟨s, hs, t, ht, hst⟩ := hz
      obtain ⟨s', hs', t', ht', hst'⟩ := hw
      refine ⟨s + s', S.add_mem hs hs', t + t', S.add_mem ht ht', ?_⟩
      rw [map_add, map_add, ← hst, ← hst']
      abel
    | neg z _ hz =>
      obtain ⟨s, hs, t, ht, hst⟩ := hz
      refine ⟨t, ht, s, hs, ?_⟩
      rw [← hst]
      abel
  obtain ⟨s, hs, t, ht, hnst⟩ := hdiff _
    (support_subset_groupClosure_of_mul_mem_adjoin_monomial S hb hbreg hbf n hn)
  refine ⟨s, hs, ?_⟩
  have hnst' : s + n = t := by
    ext i
    have hi := congrArg (fun z : σ →₀ ℤ => z i) hnst
    change (n i : ℤ) + (s i : ℤ) = (t i : ℤ) at hi
    have hi' : (s i : ℤ) + (n i : ℤ) = (t i : ℤ) := (add_comm _ _).trans hi
    change s i + n i = t i
    exact_mod_cast hi'
  rwa [hnst']

end MvPolynomial
