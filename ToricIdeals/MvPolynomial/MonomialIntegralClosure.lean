module

public import ToricIdeals.MvPolynomial.MonomialSubalgebra
public import Mathlib.RingTheory.IntegralClosure.IntegrallyClosed

/-!
# Relative root closure of multivariate monomial subalgebras

Let `R` be a commutative domain and `S` an additive submonoid of `σ →₀ ℕ`.
If the subalgebra generated by the monomials with exponents in `S` is integrally
closed in its own fraction field, then `b, b + n, k • n ∈ S` with `0 < k`
imply `n ∈ S`. The variable type and coefficient ring have independent universes;
neither the variables nor `S` need be finite or finitely generated. No integral
closedness, field, Noetherian, or characteristic assumption is placed on `R`.

The difference witness matters: the quotient of the monomials with exponents
`b + n` and `b` belongs to the subalgebra's own fraction field. Integral closedness
inside an unrelated ambient field is not substituted for this condition. The
proof uses the existing power-divisibility theorem inside the subalgebra and
then cancels the nonzero denominator monomial in the polynomial domain.

This is a necessary relative root-closure condition, not an ambient saturation
criterion or a converse normality classification. Zero exponents and empty
variable types are included.

## References

* Anne Baanen's Mathlib development of integrally closed rings, specifically
  `IsIntegrallyClosed.pow_dvd_pow_iff`.
* The polynomial-exponent argument in
  `ToricIdeals.Polynomial.MonomialIntegralClosure`, extended here to independently
  universed multivariate polynomials using the restricted-support API.
-/

@[expose] public section

namespace MvPolynomial

universe u v

variable {R : Type u} {σ : Type v} [CommRing R] [IsDomain R]

/-- Integral closedness in the monomial subalgebra's own fraction field forces
an exponent into `S` when it is both a difference of admissible exponents and a
root of an admissible positive multiple. There is no normality assumption on the
coefficient domain and no finiteness assumption on variables or generators. -/
theorem mem_of_isIntegrallyClosed_adjoin_monomial (S : AddSubmonoid (σ →₀ ℕ))
    (h : IsIntegrallyClosed ↥(Algebra.adjoin R
      (Set.range fun s : S => monomial (s : σ →₀ ℕ) (1 : R))))
    {b n : σ →₀ ℕ} {k : ℕ} (hb : b ∈ S) (hbn : b + n ∈ S) (hk : 0 < k)
    (hkn : k • n ∈ S) : n ∈ S := by
  let A := Algebra.adjoin R
    (Set.range fun s : S => monomial (s : σ →₀ ℕ) (1 : R))
  let a : A := ⟨monomial b 1, (monomial_mem_adjoin_monomial_iff S b 1).mpr (Or.inl hb)⟩
  let c : A := ⟨monomial (b + n) 1,
    (monomial_mem_adjoin_monomial_iff S (b + n) 1).mpr (Or.inl hbn)⟩
  let d : A := ⟨monomial (k • n) 1,
    (monomial_mem_adjoin_monomial_iff S (k • n) 1).mpr (Or.inl hkn)⟩
  let : IsIntegrallyClosed A := h
  have hdiv : a ^ k ∣ c ^ k := by
    refine ⟨d, ?_⟩
    apply Subtype.ext
    change monomial (b + n) (1 : R) ^ k =
      monomial b (1 : R) ^ k * monomial (k • n) (1 : R)
    simp only [monomial_pow, one_pow, monomial_mul_monomial, one_mul, smul_add]
  obtain ⟨z, hz⟩ := (IsIntegrallyClosed.pow_dvd_pow_iff (Nat.ne_of_gt hk)).mp hdiv
  have hz' : (z : MvPolynomial σ R) = monomial n 1 := by
    apply mul_left_cancel₀ (by simp : monomial b (1 : R) ≠ 0)
    calc
      monomial b (1 : R) * (z : MvPolynomial σ R) = monomial (b + n) 1 :=
        (congrArg (fun t : A => (t : MvPolynomial σ R)) hz).symm
      _ = monomial b (1 : R) * monomial n 1 := by simp
  exact ((monomial_mem_adjoin_monomial_iff S n 1).mp
    (hz' ▸ z.property)).resolve_right one_ne_zero

end MvPolynomial
