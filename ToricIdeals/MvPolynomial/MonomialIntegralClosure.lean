/-!
# Integrality and relative root closure of multivariate monomial subalgebras

Over any commutative ring, integrality over the subalgebra generated by
`S`-monomials passes to each fine component `monomial n (f.coeff n)`.
The proof applies Mathlib's coefficientwise integrality theorem after diagonal
substitution. The substitution restricts to the subalgebra by its support
criterion, before any integrality argument; it is not linear for the ordinary
constant algebra structure on the subalgebra.

An integral monomial with non-nilpotent coefficient has a positive multiple of
its exponent in `S`. Consequently, over a reduced ring every exponent in the support
of an integral polynomial has such a positive multiple. This does not assert
that a power of the whole polynomial belongs to the subalgebra.

Let `R` be a commutative domain and `S` an additive submonoid of `σ →₀ ℕ`.
If the subalgebra generated by the monomials with exponents in `S` is integrally
closed in its own fraction field, then `b, b + n, k • n ∈ S` with `0 < k`
imply `n ∈ S`. The variable type and coefficient ring have independent universes;
neither the variables nor `S` need be finite or finitely generated. No integral
closedness, field, Noetherian, or characteristic assumption is placed on `R`.

The difference witness matters: the quotient of the monomials with exponents
`b + n` and `b` belongs to the subalgebra's own fraction field. Integral closedness
inside an unrelated ambient field is not substituted for this condition. The
proof uses the existing power-divisibility theorem inside the subalgebra and
then cancels the nonzero denominator monomial in the polynomial domain.

Together with integral closedness of the coefficient domain, this relative
root-closure condition is also sufficient. The proof embeds the adjoin's own
fraction field into the polynomial fraction field, uses normality of the
polynomial ring, and combines coset support with fine-component integrality.
It is not an ambient saturation criterion. Zero exponents and empty variable
types are included.

## References

* Andrew Yang's Mathlib theorem
  `MvPolynomial.isIntegral_iff_isIntegral_coeff`, applied with the scoped
  coefficientwise polynomial algebra, and Mathlib's evaluation and map API.
  The diagonal substitution and monic-relation coefficient comparison use
  these existing constructions without an additional grading structure.
* Anne Baanen's Mathlib development of integrally closed rings, specifically
  `IsIntegrallyClosed.pow_dvd_pow_iff`.
* The polynomial-exponent argument in
  `ToricIdeals.Polynomial.MonomialIntegralClosure`, extended here to independently
  universed multivariate polynomials using the restricted-support API.
* `MultivariatePolynomials.IntegrallyClosed` supplies arbitrary-variable polynomial
  normality, following Stacks Project Tag 030A and Mathlib's coefficientwise proof.
* `IntegralClosure.LinearRetract` supplies descent to the coefficients along the
  constant-term retraction. The sufficiency proof composes Mathlib's fraction-ring
  map and injective integrality-reflection APIs with the existing coset-support
  and fine-component results.
-/

@[expose] public section

namespace MvPolynomial

universe u v

variable {R : Type u} {σ : Type v} [CommRing R]

private noncomputable def diagonal :
    MvPolynomial σ R →+* MvPolynomial σ (MvPolynomial σ R) :=
  eval₂Hom (C.comp C) (fun i => C (X i) * X i)

private theorem diagonal_monomial (n : σ →₀ ℕ) (r : R) :
    diagonal (monomial n r) = monomial n (monomial n r) := by
  classical
  rw [diagonal, eval₂Hom_monomial]
  simp only [RingHom.comp_apply, monomial_eq, Finsupp.prod, mul_pow,
    Finset.prod_mul_distrib, map_mul, map_prod, map_pow, mul_assoc]

private theorem coeff_diagonal (f : MvPolynomial σ R) (n : σ →₀ ℕ) :
    (diagonal f).coeff n = monomial n (f.coeff n) := by
  classical
  induction f using induction_on' with
  | monomial m r =>
    rw [diagonal_monomial]
    by_cases h : m = n
    · subst m
      simp
    · simp [coeff_monomial, h]
  | add f g hf hg =>
    simp only [map_add, AddMonoidAlgebra.coeff_add, Finsupp.add_apply, hf, hg]

/-- Every fine monomial component of an element integral over a monomial
subalgebra is integral over the same subalgebra. The coefficient ring need not
be a domain, and the variables and coefficient ring have independent universes. -/
theorem isIntegral_monomial_coeff_adjoin_monomial
    (S : AddSubmonoid (σ →₀ ℕ)) {f : MvPolynomial σ R}
    (hf : IsIntegral (Algebra.adjoin R
      (Set.range fun s : S => monomial (s : σ →₀ ℕ) (1 : R))) f)
    (n : σ →₀ ℕ) :
    IsIntegral (Algebra.adjoin R
      (Set.range fun s : S => monomial (s : σ →₀ ℕ) (1 : R)))
      (monomial n (f.coeff n)) := by
  classical
  let A := Algebra.adjoin R
    (Set.range fun s : S => monomial (s : σ →₀ ℕ) (1 : R))
  let i : A →+* MvPolynomial σ R := A.val.toRingHom
  let J : MvPolynomial σ A →+* MvPolynomial σ (MvPolynomial σ R) := map i
  have hJ : Function.Injective J := map_injective i Subtype.val_injective
  have hland (a : A) : ∃ q : MvPolynomial σ A, J q = diagonal (a : MvPolynomial σ R) := by
    have hcomp (m : σ →₀ ℕ) :
        monomial m ((a : MvPolynomial σ R).coeff m) ∈ A := by
      apply (monomial_mem_adjoin_monomial_iff S m _).mpr
      by_cases hm : (a : MvPolynomial σ R).coeff m = 0
      · exact Or.inr hm
      · exact Or.inl ((mem_adjoin_monomial_iff S _).mp a.property
          (mem_support_iff.mpr hm))
    refine ⟨∑ m ∈ (a : MvPolynomial σ R).support,
      monomial m ⟨_, hcomp m⟩, ?_⟩
    simp only [J, map_sum, map_monomial]
    change (∑ m ∈ (a : MvPolynomial σ R).support,
      monomial m (monomial m ((a : MvPolynomial σ R).coeff m))) = _
    simp only [← diagonal_monomial, ← map_sum, support_sum_monomial_coeff]
  choose lift hlift using hland
  let dA : A →+* MvPolynomial σ A :=
    { toFun := lift
      map_one' := hJ (by simp [hlift])
      map_mul' := fun a b => hJ (by simp [hlift])
      map_zero' := hJ (by simp [hlift])
      map_add' := fun a b => hJ (by simp [hlift]) }
  let := algebraMvPolynomial (R := A) (S := MvPolynomial σ R) (σ := σ)
  have hsquare : (algebraMap (MvPolynomial σ A)
      (MvPolynomial σ (MvPolynomial σ R))).comp dA = diagonal.comp i := by
    apply RingHom.ext
    intro a
    exact hlift a
  have hdiag : IsIntegral (MvPolynomial σ A) (diagonal f) :=
    hf.map_of_comp_eq dA diagonal hsquare
  simpa only [coeff_diagonal] using (isIntegral_iff_isIntegral_coeff.mp hdiag) n

/-- A monomial integral over a monomial subalgebra has a positive multiple of
its exponent in the defining submonoid whenever its coefficient is not
nilpotent. Nonzero alone would not suffice over an arbitrary commutative ring. -/
theorem exists_pos_nsmul_mem_of_isIntegral_monomial
    (S : AddSubmonoid (σ →₀ ℕ)) {n : σ →₀ ℕ} {r : R}
    (hr : ¬ IsNilpotent r)
    (h : IsIntegral (Algebra.adjoin R
      (Set.range fun s : S => monomial (s : σ →₀ ℕ) (1 : R))) (monomial n r)) :
    ∃ k : ℕ, 0 < k ∧ k • n ∈ S := by
  classical
  let A := Algebra.adjoin R
    (Set.range fun s : S => monomial (s : σ →₀ ℕ) (1 : R))
  change IsIntegral A (monomial n r) at h
  obtain ⟨p, hp, hroot⟩ := h
  by_contra hnone
  have hnot (k : ℕ) (hk : 0 < k) : k • n ∉ S := fun hkn => hnone ⟨k, hk, hkn⟩
  have hcoeff (j : ℕ) (hj : j < p.natDegree) :
      (p.coeff j : MvPolynomial σ R).coeff ((p.natDegree - j) • n) = 0 := by
    by_contra hc
    exact hnot (p.natDegree - j) (Nat.sub_pos_of_lt hj)
      ((mem_adjoin_monomial_iff S _).mp (p.coeff j).property (mem_support_iff.mpr hc))
  have heq : (monomial n r) ^ p.natDegree +
      ∑ j ∈ Finset.range p.natDegree,
        (p.coeff j : MvPolynomial σ R) * (monomial n r) ^ j = 0 := by
    rw [hp.as_sum] at hroot
    simpa only [Polynomial.eval₂_add, Polynomial.eval₂_pow, Polynomial.eval₂_X,
      Polynomial.eval₂_finsetSum, Polynomial.eval₂_mul, Polynomial.eval₂_C,
      Subalgebra.algebraMap_apply] using hroot
  have hzero : r ^ p.natDegree = 0 := by
    have := congrArg (fun f : MvPolynomial σ R => f.coeff (p.natDegree • n)) heq
    rw [AddMonoidAlgebra.coeff_add, Finsupp.add_apply, coeff_sum] at this
    have hsum : ∑ j ∈ Finset.range p.natDegree,
        ((p.coeff j : MvPolynomial σ R) * monomial n r ^ j).coeff
          (p.natDegree • n) = 0 := by
      apply Finset.sum_eq_zero
      intro j hj
      rw [monomial_pow]
      have hexp : p.natDegree • n = (p.natDegree - j) • n + j • n := by
        rw [← add_nsmul, Nat.sub_add_cancel (Nat.le_of_lt (Finset.mem_range.mp hj))]
      rw [hexp, coeff_mul_monomial, hcoeff j (Finset.mem_range.mp hj), zero_mul]
    rw [hsum, add_zero] at this
    simpa [monomial_pow] using this
  exact hr ⟨p.natDegree, hzero⟩

/-- Every exponent in the support of an integral polynomial over a reduced ring has
some positive multiple in the submonoid defining the monomial subalgebra. This
concerns powers of the individual monomials, not a power of the whole polynomial. -/
theorem exists_pos_nsmul_mem_of_isIntegral_of_mem_support [IsReduced R]
    (S : AddSubmonoid (σ →₀ ℕ)) {f : MvPolynomial σ R}
    (hf : IsIntegral (Algebra.adjoin R
      (Set.range fun s : S => monomial (s : σ →₀ ℕ) (1 : R))) f)
    {n : σ →₀ ℕ} (hn : n ∈ f.support) : ∃ k : ℕ, 0 < k ∧ k • n ∈ S := by
  apply exists_pos_nsmul_mem_of_isIntegral_monomial S
    (fun hnil => (mem_support_iff.mp hn) hnil.eq_zero)
  exact isIntegral_monomial_coeff_adjoin_monomial S hf n

variable [IsDomain R]

/-- Integral closedness in the monomial subalgebra's own fraction field forces
an exponent into `S` when it is both a difference of admissible exponents and a
root of an admissible positive multiple. There is no normality assumption on the
coefficient domain and no finiteness assumption on variables or generators. -/
theorem mem_of_isIntegrallyClosed_adjoin_monomial (S : AddSubmonoid (σ →₀ ℕ))
    (h : IsIntegrallyClosed ↥(Algebra.adjoin R
      (Set.range fun s : S => monomial (s : σ →₀ ℕ) (1 : R))))
    {b n : σ →₀ ℕ} {k : ℕ} (hb : b ∈ S) (hbn : b + n ∈ S) (hk : 0 < k)
    (hkn : k • n ∈ S) : n ∈ S := by
  let A := Algebra.adjoin R
    (Set.range fun s : S => monomial (s : σ →₀ ℕ) (1 : R))
  let a : A := ⟨monomial b 1, (monomial_mem_adjoin_monomial_iff S b 1).mpr (Or.inl hb)⟩
  let c : A := ⟨monomial (b + n) 1,
    (monomial_mem_adjoin_monomial_iff S (b + n) 1).mpr (Or.inl hbn)⟩
  let d : A := ⟨monomial (k • n) 1,
    (monomial_mem_adjoin_monomial_iff S (k • n) 1).mpr (Or.inl hkn)⟩
  let : IsIntegrallyClosed A := h
  have hdiv : a ^ k ∣ c ^ k := by
    refine ⟨d, ?_⟩
    apply Subtype.ext
    change monomial (b + n) (1 : R) ^ k =
      monomial b (1 : R) ^ k * monomial (k • n) (1 : R)
    simp only [monomial_pow, one_pow, monomial_mul_monomial, one_mul, smul_add]
  obtain ⟨z, hz⟩ := (IsIntegrallyClosed.pow_dvd_pow_iff (Nat.ne_of_gt hk)).mp hdiv
  have hz' : (z : MvPolynomial σ R) = monomial n 1 := by
    apply mul_left_cancel₀ (by simp : monomial b (1 : R) ≠ 0)
    calc
      monomial b (1 : R) * (z : MvPolynomial σ R) = monomial (b + n) 1 :=
        (congrArg (fun t : A => (t : MvPolynomial σ R)) hz).symm
      _ = monomial b (1 : R) * monomial n 1 := by simp
  exact ((monomial_mem_adjoin_monomial_iff S n 1).mp
    (hz' ▸ z.property)).resolve_right one_ne_zero

/-- The standard monomial subalgebra over a commutative domain is integrally closed
in its own fraction field exactly when the coefficient domain is integrally closed
and the exponent submonoid is relatively root closed. The coefficient and variable
types have independent universes; no finiteness assumption is required. -/
theorem isIntegrallyClosed_adjoin_monomial_iff (S : AddSubmonoid (σ →₀ ℕ)) :
    IsIntegrallyClosed ↥(Algebra.adjoin R
      (Set.range fun s : S => monomial (s : σ →₀ ℕ) (1 : R))) ↔
      IsIntegrallyClosed R ∧ ∀ (b n : σ →₀ ℕ) (k : ℕ),
        0 < k → b ∈ S → b + n ∈ S → k • n ∈ S → n ∈ S := by
  classical
  let P := MvPolynomial σ R
  let A := Algebra.adjoin R
    (Set.range fun s : S => monomial (s : σ →₀ ℕ) (1 : R))
  constructor
  · intro h
    refine ⟨?_, fun b n k hk hb hbn hkn =>
      mem_of_isIntegrallyClosed_adjoin_monomial S h hb hbn hk hkn⟩
    let r : A →ₗ[R] R := ((aeval fun _ : σ => (0 : R)).comp A.val).toLinearMap
    have hr (a : R) : r (algebraMap R A a) = a :=
      ((aeval fun _ : σ => (0 : R)).comp A.val).commutes a
    let : IsIntegrallyClosed A := h
    refine IsIntegrallyClosed.of_linearRetract ?_ r hr
    intro a b hab
    simpa only [hr] using congrArg r hab
  · rintro ⟨hR, hS⟩
    let : IsIntegrallyClosed R := hR
    let θ : FractionRing A →+* FractionRing P :=
      IsFractionRing.map (j := A.val.toRingHom) Subtype.val_injective
    have hθ (a : A) : θ (algebraMap A (FractionRing A) a) =
        algebraMap P (FractionRing P) (a : P) :=
      IsLocalization.map_eq _ _
    have hθcomp : (algebraMap A (FractionRing P)).comp (RingHom.id A) =
        θ.comp (algebraMap A (FractionRing A)) := by
      ext a
      exact (hθ a).symm
    apply (isIntegrallyClosed_iff (FractionRing A)).mpr
    intro x hx
    have hxA : IsIntegral A (θ x) := hx.map_of_comp_eq (RingHom.id A) θ hθcomp
    obtain ⟨p, hp⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral
      (hxA.tower_top : IsIntegral P (θ x))
    have hpint : IsIntegral A p := by
      apply (isIntegral_algHom_iff (IsScalarTower.toAlgHom A P (FractionRing P))
        (IsFractionRing.injective P (FractionRing P))).mp
      change IsIntegral A (algebraMap P (FractionRing P) p)
      rw [hp]
      exact hxA
    obtain ⟨a, b, hb, rfl⟩ := IsFractionRing.div_surjective A x
    have hbP : (b : P) ≠ 0 := by
      intro h
      exact nonZeroDivisors.ne_zero hb (Subtype.ext h)
    have hbF : algebraMap P (FractionRing P) (b : P) ≠ 0 := by
      simpa only [map_zero] using
        (IsFractionRing.injective P (FractionRing P)).ne hbP
    have hbp : (b : P) * p = (a : P) := by
      apply IsFractionRing.injective P (FractionRing P)
      rw [map_mul, hp, map_div₀, hθ, hθ]
      exact mul_div_cancel₀ _ hbF
    have hpA : p ∈ A := by
      rw [← support_sum_monomial_coeff p]
      apply A.sum_mem
      intro n hn
      obtain ⟨s, hs, hsn⟩ := exists_mem_add_mem_of_mul_mem_adjoin_monomial S
        b.property (fun _ _ h => mul_left_cancel₀ hbP h)
        (by rw [hbp]; exact a.property) hn
      obtain ⟨k, hk, hkn⟩ :=
        exists_pos_nsmul_mem_of_isIntegral_of_mem_support S hpint hn
      have hnS : n ∈ S := hS s n k hk hs hsn hkn
      have hm : monomial n (1 : R) ∈ A := Algebra.subset_adjoin ⟨⟨n, hnS⟩, rfl⟩
      have heq : monomial n (p.coeff n) = C (p.coeff n) * monomial n (1 : R) := by
        rw [C_mul_monomial, mul_one]
      rw [heq]
      exact A.mul_mem (A.algebraMap_mem _) hm
    refine ⟨⟨p, hpA⟩, ?_⟩
    apply θ.injective
    rw [hθ]
    exact hp

end MvPolynomial
