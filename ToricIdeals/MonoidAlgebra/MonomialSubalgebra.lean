module

public import Mathlib.Algebra.Algebra.Subalgebra.Lattice
public import Mathlib.Algebra.MonoidAlgebra.Basic

/-!
# Subalgebras generated by monomials

For a submonoid `S` of a monoid `M`, `MonoidAlgebra.monomialSubalgebra R S`
is the `R`-subalgebra of `R[M]` generated by coefficient-one monomials with
exponents in `S`. Its underlying module is `MonoidAlgebra.supported R R S`,
so membership is characterized by containment of coefficient support.
The coefficient semiring may be trivial, and the exponent monoid need not be
commutative or cancellative.

The support characterization generalizes the multivariate-polynomial result in
`ToricIdeals.MvPolynomial.MonomialSubalgebra`. It combines Mathlib's existing
linear-span descriptions of adjoining and restricted support.

## References

* Mathlib's subalgebra lattice and adjoining API, by Kenny Lau and Yury Kudryashov.
* Mathlib's monoid-algebra and restricted-support API, by Johannes Hölzl,
  Yury Kudryashov, and Kim Morrison.
* The monomial-adjoin support proof in `ToricIdeals.MvPolynomial.MonomialSubalgebra`,
  by Formal Frontier Agents.
-/

@[expose] public section

namespace MonoidAlgebra

universe u v

open scoped Pointwise

variable {R : Type u} {M : Type v} [CommSemiring R] [Monoid M]

/-- The subalgebra generated by coefficient-one monomials whose exponents lie in
`S`. -/
noncomputable def monomialSubalgebra (R : Type u) [CommSemiring R] (S : Submonoid M) :
    Subalgebra R R[M] :=
  Algebra.adjoin R (Set.range fun s : S => single (s : M) (1 : R))

/-- The monomial subalgebra is the adjoin of its coefficient-one monomials. -/
theorem monomialSubalgebra_eq_adjoin (S : Submonoid M) :
    monomialSubalgebra R S =
      Algebra.adjoin R (Set.range fun s : S => single (s : M) (1 : R)) :=
  rfl

/-- A subalgebra contains the monomial subalgebra exactly when it contains all
of its coefficient-one generators. -/
theorem monomialSubalgebra_le_iff (S : Submonoid M) {A : Subalgebra R R[M]} :
    monomialSubalgebra R S ≤ A ↔ ∀ s : S, single (s : M) (1 : R) ∈ A := by
  rw [monomialSubalgebra_eq_adjoin, Algebra.adjoin_le_iff, Set.range_subset_iff]
  rfl

/-- The underlying module of the monomial subalgebra consists of the elements
supported on the exponent submonoid. No nontriviality assumption on `R` is needed. -/
theorem monomialSubalgebra_toSubmodule (S : Submonoid M) :
    (monomialSubalgebra R S).toSubmodule = supported R R (S : Set M) := by
  rw [monomialSubalgebra_eq_adjoin, supported_eq_span_single, Set.image_eq_range]
  apply Algebra.adjoin_eq_span_of_subset
  intro p hp
  apply Submodule.subset_span
  refine Submonoid.closure_induction ?_ ?_ ?_ hp
  · intro x hx
    exact hx
  · exact ⟨⟨1, S.one_mem⟩, one_def.symm⟩
  · rintro x y hx hy ⟨s, rfl⟩ ⟨t, rfl⟩
    exact ⟨s * t, by simp only [Submonoid.coe_mul, single_mul_single, mul_one]⟩

/-- Membership in a monomial subalgebra means that every exponent with nonzero
coefficient belongs to the exponent submonoid. -/
theorem mem_monomialSubalgebra_iff (S : Submonoid M) (p : R[M]) :
    p ∈ monomialSubalgebra R S ↔ (↑p.coeff.support : Set M) ⊆ S := by
  rw [← Subalgebra.mem_toSubmodule, monomialSubalgebra_toSubmodule, mem_supported]

/-- A single monomial belongs to a monomial subalgebra exactly when its exponent
belongs to the submonoid or its coefficient vanishes. -/
@[simp]
theorem single_mem_monomialSubalgebra_iff (S : Submonoid M) (m : M) (r : R) :
    single m r ∈ monomialSubalgebra R S ↔ m ∈ S ∨ r = 0 := by
  classical
  rw [mem_monomialSubalgebra_iff]
  by_cases hr : r = 0
  · simp [hr]
  · simp [coeff_single, hr]

/-- Enlarging the exponent submonoid enlarges its monomial subalgebra. -/
theorem monomialSubalgebra_mono {S T : Submonoid M} (hST : S ≤ T) :
    monomialSubalgebra R S ≤ monomialSubalgebra R T := by
  intro p hp
  exact (mem_monomialSubalgebra_iff T p).2
    (((mem_monomialSubalgebra_iff S p).1 hp).trans hST)

/-- The span over a monomial subalgebra of the coefficient-one monomials on an
arbitrary set `E`, restricted to the coefficient semiring, is supported on
`S * E`. The order of these factors records the left scalar action. -/
theorem span_single_restrictScalars_monomialSubalgebra (S : Submonoid M) (E : Set M) :
    (Submodule.span (monomialSubalgebra R S)
      ((fun m => single m (1 : R)) '' E)).restrictScalars R =
        supported R R ((S : Set M) * E) := by
  let g : S → monomialSubalgebra R S := fun s =>
    ⟨single (s : M) 1, (single_mem_monomialSubalgebra_iff S s 1).2 (Or.inl s.property)⟩
  have hg : Submodule.span R (Set.range g) = ⊤ := by
    apply (Submodule.span_range_subtype_eq_top_iff
      (monomialSubalgebra R S).toSubmodule
      (fun s : S => (single_mem_monomialSubalgebra_iff S s 1).2
        (Or.inl s.property))).2
    rw [monomialSubalgebra_toSubmodule, supported_eq_span_single, Set.image_eq_range]
    rfl
  rw [← Submodule.span_smul_of_span_eq_top hg, supported_eq_span_single]
  congr 1
  ext p
  constructor
  · rintro ⟨a, ⟨s, rfl⟩, b, ⟨e, he, rfl⟩, rfl⟩
    refine ⟨(s : M) * e, ⟨s, s.property, e, he, rfl⟩, ?_⟩
    simp only [g, Subalgebra.smul_def, smul_eq_mul, single_mul_single, one_mul]
  · rintro ⟨m, ⟨s, hs, e, he, rfl⟩, rfl⟩
    refine ⟨g ⟨s, hs⟩, ⟨⟨s, hs⟩, rfl⟩, single e 1, ⟨e, he, rfl⟩, ?_⟩
    simp only [g, Subalgebra.smul_def, smul_eq_mul, single_mul_single, one_mul]

end MonoidAlgebra
