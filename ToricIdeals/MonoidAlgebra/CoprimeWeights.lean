/-!
# Coprime weighted fibers in an additive monoid algebra

For coprime natural numbers `a,b`, two bivariate exponent vectors of equal
`(b,a)`-weight give a binomial in the principal left ideal generated by
`X₀^a - X₁^b`. The coefficient ring may be noncommutative, and the binomial
may have any common coefficient.

The proof describes the natural-number fiber steps and telescopes their
monomial differences using only left multiplication. No ring structure on a
quotient by a left ideal is used. Zero weights are allowed when coprimality
holds; in particular the generators on the two axes are `1 - X₁` and `X₀ - 1`.

The kernel of the stock weight pushforward is exactly this principal left ideal.
The proof reuses the coefficientwise fiber-normalization interface, choosing
representatives only for attainable weights, with zero as a default elsewhere.
No surjectivity onto all natural weights is asserted; for example, weights
`(3,2)` miss `1`.

## References

The proof uses Mathlib's natural-weight and additive-monoid-algebra pushforward
APIs and the coefficientwise normalization theorem in
`ToricIdeals.MonoidAlgebra.FiberNormalization`.
-/

@[expose] public section

private theorem coprime_weight_step_of_le {a b x y u v : ℕ}
    (hab : Nat.Coprime a b) (ha : 0 < a) (hxu : x ≤ u)
    (h : b * x + a * y = b * u + a * v) :
    ∃ k : ℕ, u = x + a * k ∧ y = v + b * k := by
  have hvy : v ≤ y := by
    by_contra hvy
    have hyv : y + 1 ≤ v := by omega
    nlinarith [Nat.mul_le_mul_left b hxu, Nat.mul_le_mul_left a hyv]
  have hs : b * (u - x) = a * (y - v) := by
    have hx : x + (u - x) = u := Nat.add_sub_of_le hxu
    have hy : v + (y - v) = y := Nat.add_sub_of_le hvy
    nlinarith
  have hd : a ∣ b * (u - x) := by
    rw [hs]
    exact dvd_mul_right a (y - v)
  obtain ⟨k, hk⟩ := hab.dvd_mul_left.mp hd
  refine ⟨k, ?_, ?_⟩
  · omega
  · have heq : a * (y - v) = a * (b * k) := by
      rw [← hs, hk]
      ac_rfl
    have hk' : y - v = b * k := Nat.eq_of_mul_eq_mul_left ha heq
    omega

private theorem coprime_weight_step {a b x y u v : ℕ}
    (hab : Nat.Coprime a b) (h : b * x + a * y = b * u + a * v) :
    (∃ k : ℕ, u = x + a * k ∧ y = v + b * k) ∨
      (∃ k : ℕ, x = u + a * k ∧ v = y + b * k) := by
  rcases Nat.eq_zero_or_pos a with ha | ha
  · subst a
    have hb : b = 1 := by simpa using hab
    subst b
    simp only [one_mul, zero_mul, add_zero] at h
    subst u
    rcases le_total v y with hvy | hyv
    · exact Or.inl ⟨y - v, by simp [Nat.add_sub_of_le hvy]⟩
    · exact Or.inr ⟨v - y, by simp [Nat.add_sub_of_le hyv]⟩
  · rcases le_total x u with hxu | hux
    · exact Or.inl (coprime_weight_step_of_le hab ha hxu h)
    · exact Or.inr (coprime_weight_step_of_le hab ha hux h.symm)

namespace AddMonoidAlgebra

universe uR uM

variable {R : Type uR} [Ring R]

-- The second summand is also a left multiple of the generator. Only exponent
-- addition is commuted: the coefficient products are `1 * c` and `c * 1`.
private theorem single_add_nsmul_sub_mem_span {M : Type uM} [AddCommMonoid M]
    (p q t : M) (c : R) (k : ℕ) :
    (single (t + k • p) c - single (t + k • q) c : AddMonoidAlgebra R M) ∈
      Ideal.span {single p (1 : R) - single q (1 : R)} := by
  induction k with
  | zero => simp
  | succ k ih =>
    have hgen : (single p (1 : R) - single q (1 : R) : AddMonoidAlgebra R M) ∈
        Ideal.span {single p (1 : R) - single q (1 : R)} :=
      Ideal.mem_span_singleton_self _
    have hmem := (Ideal.span {single p (1 : R) - single q (1 : R)}).add_mem
      ((Ideal.span _).mul_mem_left (single p 1) ih)
      ((Ideal.span _).mul_mem_left (single (t + k • q) c) hgen)
    convert hmem using 1
    simp only [mul_sub, single_mul_single, one_mul, mul_one, succ_nsmul]
    simp only [add_comm, add_left_comm]
    abel

/-- Equal `(b,a)`-weights for coprime `a,b` give membership of every
common-coefficient binomial in the left ideal generated by `X₀^a - X₁^b`.

The coefficient ring is arbitrary, including noncommutative rings and the
zero ring. Coprime zero-weight cases are included, with no positivity premise. -/
theorem single_sub_single_mem_span_of_coprime_weight_eq
    {a b : ℕ} (hab : Nat.Coprime a b) {d e : Fin 2 →₀ ℕ} (c : R)
    (hde : b * d (0 : Fin 2) + a * d (1 : Fin 2) =
      b * e (0 : Fin 2) + a * e (1 : Fin 2)) :
    (single d c - single e c : AddMonoidAlgebra R (Fin 2 →₀ ℕ)) ∈
      Ideal.span
        {(single (Finsupp.single (0 : Fin 2) a) (1 : R) -
          single (Finsupp.single (1 : Fin 2) b) (1 : R) :
            AddMonoidAlgebra R (Fin 2 →₀ ℕ))} := by
  have hstep {d e : Fin 2 →₀ ℕ} (k : ℕ)
      (h0 : d 0 = e 0 + a * k) (h1 : e 1 = d 1 + b * k) :
      (single d c - single e c : AddMonoidAlgebra R (Fin 2 →₀ ℕ)) ∈
        Ideal.span {single (Finsupp.single (0 : Fin 2) a) (1 : R) -
          single (Finsupp.single (1 : Fin 2) b) (1 : R)} := by
    let t : Fin 2 →₀ ℕ := Finsupp.single 0 (e 0) + Finsupp.single 1 (d 1)
    have hd : d = t + k • Finsupp.single 0 a := by
      ext i
      fin_cases i <;> simp [t, h0, Nat.mul_comm]
    have he : e = t + k • Finsupp.single 1 b := by
      ext i
      fin_cases i <;> simp [t, h1, Nat.mul_comm]
    rw [hd, he]
    exact single_add_nsmul_sub_mem_span _ _ t c k
  rcases coprime_weight_step hab hde with ⟨k, h0, h1⟩ | ⟨k, h0, h1⟩
  · simpa only [neg_sub] using
      (Ideal.span {(single (Finsupp.single (0 : Fin 2) a) (1 : R) -
        single (Finsupp.single (1 : Fin 2) b) (1 : R) :
          AddMonoidAlgebra R (Fin 2 →₀ ℕ))}).neg_mem (hstep k h0 h1)
  · exact hstep k h0 h1

/-- For coprime natural exponents, the kernel of the `(b,a)`-weight
pushforward is the principal left ideal generated by `X₀^a - X₁^b`.

This uses the all-coefficient fiber congruence and the coefficientwise
normalization theorem. Coefficients may lie in any ring, including a
noncommutative ring or the zero ring, and coprime zero-weight cases are included.
There is no surjectivity assumption on the natural-weight map. -/
theorem ker_mapDomainRingHom_weight_eq_span_of_coprime
    {a b : ℕ} (hab : Nat.Coprime a b) :
    RingHom.ker
      (AddMonoidAlgebra.mapDomainRingHom R
        (Finsupp.weight
          (fun i : Fin 2 => if i = (0 : Fin 2) then b else a) :
            (Fin 2 →₀ ℕ) →+ ℕ)) =
      Ideal.span
        {(single (Finsupp.single (0 : Fin 2) a) (1 : R) -
          single (Finsupp.single (1 : Fin 2) b) (1 : R) :
            AddMonoidAlgebra R (Fin 2 →₀ ℕ))} := by
  classical
  let w : Fin 2 → ℕ := fun i => if i = 0 then b else a
  let φ : (Fin 2 →₀ ℕ) →+ ℕ := Finsupp.weight w
  let I : Ideal (AddMonoidAlgebra R (Fin 2 →₀ ℕ)) :=
    Ideal.span {single (Finsupp.single (0 : Fin 2) a) (1 : R) -
      single (Finsupp.single (1 : Fin 2) b) (1 : R)}
  -- Choose on the range, not on all target weights: the cusp misses weight 1.
  let normal : ℕ → (Fin 2 →₀ ℕ) :=
    fun n => if h : n ∈ Set.range φ then h.choose else 0
  have hnormal (m : Fin 2 →₀ ℕ) : φ (normal (φ m)) = φ m := by
    dsimp only [normal]
    rw [dite_eq_left (Set.mem_range_self m)]
    exact (Set.mem_range_self m : φ m ∈ Set.range φ).choose_spec
  have hweight (m : Fin 2 →₀ ℕ) : φ m = b * m 0 + a * m 1 := by
    simp [φ, w, Finsupp.weight_eq_sum, Fin.sum_univ_two, Nat.mul_comm]
  have hcongr (m : Fin 2 →₀ ℕ) (r : R) :
      single m r - single (normal (φ m)) r ∈ I := by
    apply single_sub_single_mem_span_of_coprime_weight_eq hab r
    rw [← hweight, ← hweight, hnormal]
  have hI : I ≤ RingHom.ker (mapDomainRingHom R φ) := by
    refine Ideal.span_le.mpr ?_
    intro g hg
    obtain rfl := Set.mem_singleton_iff.mp hg
    change (mapDomainRingHom R φ) _ = 0
    rw [map_sub]
    simp [mapDomain_single, φ, w, Finsupp.weight_single, smul_eq_mul, Nat.mul_comm]
  exact (ToricIdeals.AddMonoidAlgebra.ideal_eq_ker_mapDomainRingHom
    I φ normal hcongr hI).symm

/-- Membership in the coprime weighted binomial's principal left ideal is
characterized by vanishing under the stock natural-weight pushforward. -/
theorem mem_span_iff_mapDomain_weight_eq_zero_of_coprime
    {a b : ℕ} (hab : Nat.Coprime a b)
    {f : AddMonoidAlgebra R (Fin 2 →₀ ℕ)} :
    f ∈ Ideal.span
      {(single (Finsupp.single (0 : Fin 2) a) (1 : R) -
        single (Finsupp.single (1 : Fin 2) b) (1 : R) :
          AddMonoidAlgebra R (Fin 2 →₀ ℕ))} ↔
      AddMonoidAlgebra.mapDomain
        (Finsupp.weight
          (fun i : Fin 2 => if i = (0 : Fin 2) then b else a) :
            (Fin 2 →₀ ℕ) →+ ℕ) f = 0 := by
  rw [← ker_mapDomainRingHom_weight_eq_span_of_coprime hab]
  rfl

end AddMonoidAlgebra
