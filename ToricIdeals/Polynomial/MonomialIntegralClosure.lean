module

public import ToricIdeals.Polynomial.MonomialSubalgebra
public import Mathlib.RingTheory.IntegralClosure.IntegrallyClosed
import Mathlib.Algebra.Group.Submonoid.Membership

/-!
# Integral closedness forces cyclic exponent submonoids

For a coefficient domain `R` and an additive submonoid `S` of `ℕ`, integral
closedness of the subalgebra generated by `X ^ s` for `s ∈ S` forces the following
root-closure property: if `b`, `b + n` and a positive multiple `k * n` belong to
`S`, then `n` belongs to `S`. Its contrapositive detects nonnormal monomial
subalgebras, including the cusp algebra generated by `X ^ 2` and `X ^ 3`.

In fact, integral closedness forces `S = AddSubmonoid.multiples d` for some
`d : ℕ`. The proof chooses a least positive exponent when `S` is nonbottom and
uses the root-closure property to show that every remainder modulo it vanishes.
The choice `d = 0` includes the bottom submonoid. No converse is asserted.

The difference witness `b, b + n ∈ S` is essential: the quotient must belong to
the fraction field of the subalgebra, not merely the ambient polynomial fraction
field. The proof uses power divisibility inside the subalgebra and then cancels
the nonzero monomial `X ^ b` in the polynomial ring.

There is no positivity requirement on `b` or `n`: when `n = 0`, membership follows
from `S.zero_mem`. For the bottom submonoid the difference premises force
`b = n = 0`; for the top submonoid the membership conclusion is automatic.
Neither boundary case asserts that the polynomial ring is normal over every base.

## References

The fraction-field argument is Mathlib's `IsIntegrallyClosed.pow_dvd_pow_iff`,
from Anne Baanen's development of integrally closed rings. Exponent membership
is detected by the coefficient-support characterization in
`ToricIdeals.Polynomial.MonomialSubalgebra`.
-/

@[expose] public section

namespace Polynomial

universe u

section CommRing

variable {R : Type u} [CommRing R] [IsDomain R]

/-- Integral closedness of a monomial subalgebra forces an exponent into its
additive submonoid when it is both a difference of admissible exponents and a
root of an admissible positive multiple. -/
theorem mem_of_isIntegrallyClosed_adjoin_X_pow (S : AddSubmonoid ℕ)
    (h : IsIntegrallyClosed ↥(Algebra.adjoin R
      (Set.range fun s : S => (X : R[X]) ^ (s : ℕ))))
    {b n k : ℕ} (hb : b ∈ S) (hbn : b + n ∈ S) (hk : 0 < k)
    (hkn : k * n ∈ S) : n ∈ S := by
  let A := Algebra.adjoin R (Set.range fun s : S => (X : R[X]) ^ (s : ℕ))
  let a : A := ⟨X ^ b, (X_pow_mem_adjoin_X_pow_iff S b).mpr hb⟩
  let c : A := ⟨X ^ (b + n), (X_pow_mem_adjoin_X_pow_iff S (b + n)).mpr hbn⟩
  let d : A := ⟨X ^ (k * n), (X_pow_mem_adjoin_X_pow_iff S (k * n)).mpr hkn⟩
  let : IsIntegrallyClosed A := h
  have hdiv : a ^ k ∣ c ^ k := by
    refine ⟨d, ?_⟩
    apply Subtype.ext
    change ((X : R[X]) ^ (b + n)) ^ k = (X ^ b) ^ k * X ^ (k * n)
    simp only [pow_add, mul_pow, ← pow_mul, Nat.mul_comm n k]
  obtain ⟨z, hz⟩ := (IsIntegrallyClosed.pow_dvd_pow_iff (Nat.ne_of_gt hk)).mp hdiv
  have hz' : (z : R[X]) = X ^ n := by
    apply mul_left_cancel₀ (pow_ne_zero b (X_ne_zero (R := R)))
    calc
      (X : R[X]) ^ b * (z : R[X]) = X ^ (b + n) :=
        (congrArg (fun t : A => (t : R[X])) hz).symm
      _ = X ^ b * X ^ n := pow_add _ _ _
  exact (X_pow_mem_adjoin_X_pow_iff S n).mp (hz' ▸ z.property)

/-- Integral closedness of a polynomial exponent subalgebra over a domain forces its
exponent submonoid to consist of the natural multiples of one exponent, possibly zero.
The proof combines the monomial-gap criterion with least-positive-element minimality
and Euclidean division. -/
theorem exists_eq_multiples_of_isIntegrallyClosed_adjoin_X_pow (S : AddSubmonoid ℕ)
    (h : IsIntegrallyClosed ↥(Algebra.adjoin R
      (Set.range fun s : S => (X : R[X]) ^ (s : ℕ)))) :
    ∃ d : ℕ, S = AddSubmonoid.multiples d := by
  classical
  by_cases hbot : S = ⊥
  · refine ⟨0, ?_⟩
    subst S
    ext n
    simp
  have hex : ∃ n : ℕ, n ∈ S ∧ 0 < n := by
    by_contra hn
    apply hbot
    ext n
    simp only [AddSubmonoid.mem_bot]
    constructor
    · intro hnS
      by_contra hn0
      exact hn ⟨n, hnS, Nat.pos_of_ne_zero hn0⟩
    · rintro rfl
      exact S.zero_mem
  let d := Nat.find hex
  have hd : d ∈ S ∧ 0 < d := Nat.find_spec hex
  refine ⟨d, ?_⟩
  ext p
  constructor
  · intro hp
    have hpdiv : (p / d) * d + p % d = p := by
      simpa only [Nat.mul_comm, Nat.add_comm] using Nat.mod_add_div p d
    have hb : (p / d) * d ∈ S := by
      simpa [nsmul_eq_mul] using S.nsmul_mem hd.1 (p / d)
    have hbr : (p / d) * d + p % d ∈ S := by
      rw [hpdiv]
      exact hp
    have hdr : d * (p % d) ∈ S := by
      simpa [nsmul_eq_mul, Nat.mul_comm] using S.nsmul_mem hd.1 (p % d)
    have hr : p % d ∈ S :=
      mem_of_isIntegrallyClosed_adjoin_X_pow S h
        (b := (p / d) * d) (n := p % d) (k := d) hb hbr hd.2 hdr
    have hr0 : p % d = 0 := by
      by_contra hne
      have hle : d ≤ p % d := Nat.find_min' hex ⟨hr, Nat.pos_of_ne_zero hne⟩
      exact (Nat.not_le_of_gt (Nat.mod_lt p hd.2)) hle
    apply (AddSubmonoid.mem_multiples_iff p d).mpr
    refine ⟨p / d, ?_⟩
    simpa [nsmul_eq_mul, hr0] using hpdiv
  · intro hp
    obtain ⟨q, hq⟩ := (AddSubmonoid.mem_multiples_iff p d).mp hp
    exact hq ▸ S.nsmul_mem hd.1 q

/-- A missing exponent that is a difference of admissible exponents and has an
admissible positive multiple obstructs integral closedness of the monomial subalgebra. -/
theorem not_isIntegrallyClosed_adjoin_X_pow_of_gap (S : AddSubmonoid ℕ)
    {b n k : ℕ} (hb : b ∈ S) (hbn : b + n ∈ S) (hk : 0 < k)
    (hkn : k * n ∈ S) (hn : n ∉ S) :
    ¬ IsIntegrallyClosed ↥(Algebra.adjoin R
      (Set.range fun s : S => (X : R[X]) ^ (s : ℕ))) := by
  intro h
  exact hn (mem_of_isIntegrallyClosed_adjoin_X_pow S h hb hbn hk hkn)

/-- The cusp subalgebra generated by `X ^ 2` and `X ^ 3` is not integrally
closed over any coefficient domain, in every characteristic. -/
theorem not_isIntegrallyClosed_adjoin_X_sq_X_cube :
    ¬ IsIntegrallyClosed ↥(Algebra.adjoin R ({(X : R[X]) ^ 2, X ^ 3} : Set R[X])) := by
  rw [← adjoin_X_pow_closure_pair_eq]
  apply not_isIntegrallyClosed_adjoin_X_pow_of_gap
    (b := 2) (n := 1) (k := 2)
  · exact AddSubmonoid.subset_closure (by simp)
  · exact AddSubmonoid.subset_closure (by norm_num)
  · norm_num
  · exact AddSubmonoid.subset_closure (by norm_num)
  · intro h
    obtain ⟨i, j, hij⟩ := (AddSubmonoid.mem_closure_pair 2 3 1).mp h
    simp only [nsmul_eq_mul] at hij
    omega

end CommRing

end Polynomial
