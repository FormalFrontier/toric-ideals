module

public import ToricIdeals.Polynomial.MonomialSubalgebra
public import Mathlib.RingTheory.IntegralClosure.IntegrallyClosed
public import Mathlib.RingTheory.Polynomial.IsIntegral

/-!
# Integral closedness of polynomial power subalgebras

For positive `d`, the subalgebra generated by powers of `X` with exponents in
`AddSubmonoid.multiples d` is integrally closed exactly when `R[X]` is. At degree
zero it is integrally closed exactly when `R` is. These structural equivalences
hold for every commutative coefficient ring, including the trivial ring.

Over a general commutative ring, `IsIntegrallyClosed` concerns the total quotient
ring, not scheme normality.

## References

The proofs transport Mathlib's `IsIntegrallyClosed.of_equiv` along the polynomial
power-substitution and coefficient equivalences.
-/

@[expose] public section

namespace Polynomial

universe u
variable {R : Type u} [CommRing R]

/-- Positive-degree power substitution preserves and reflects integral closedness. -/
theorem isIntegrallyClosed_adjoin_X_pow_multiples_iff (d : ℕ) (hd : 0 < d) :
    IsIntegrallyClosed ↥(Algebra.adjoin R
      (Set.range fun s : AddSubmonoid.multiples d => (X : R[X]) ^ (s : ℕ))) ↔
        IsIntegrallyClosed R[X] := by
  constructor
  · intro h
    let := h
    exact IsIntegrallyClosed.of_equiv (expandEquivAdjoinXPow (R := R) d hd).symm.toRingEquiv
  · intro h
    let := h
    exact IsIntegrallyClosed.of_equiv (expandEquivAdjoinXPow (R := R) d hd).toRingEquiv

/-- At degree zero, integral closedness is exactly that of the coefficient ring. -/
@[simp]
theorem isIntegrallyClosed_adjoin_X_pow_multiples_zero_iff :
    IsIntegrallyClosed ↥(Algebra.adjoin R
      (Set.range fun s : AddSubmonoid.multiples (0 : ℕ) => (X : R[X]) ^ (s : ℕ))) ↔
        IsIntegrallyClosed R := by
  constructor
  · intro h
    let := h
    exact IsIntegrallyClosed.of_equiv (adjoinXPowZeroEquiv (R := R)).toRingEquiv
  · intro h
    let := h
    exact IsIntegrallyClosed.of_equiv (adjoinXPowZeroEquiv (R := R)).symm.toRingEquiv

end Polynomial
