/-!
# Ideals contained in a two-generator polynomial subalgebra

For coprime natural numbers `a` and `b`, the largest ambient polynomial ideal
contained in `R[X^a, X^b]` is generated by `X^((a - 1) * (b - 1))`.
The coefficient semiring need not have cancellation or be nontrivial.
For noncoprime exponents, the largest ambient ideal is the zero ideal, including
when both exponents are zero.

The support characterization uses Mathlib's adjoin induction, additive closure,
monoid-algebra support bounds, and finite monomial expansion. The numerical bound
is supplied by Mathlib's two-generator Frobenius theorem.

## References

The numerical bound is formalized in `Mathlib.NumberTheory.FrobeniusNumber`;
product support bounds are from `Mathlib.Algebra.MonoidAlgebra.Support`.
-/

@[expose] public section

namespace Polynomial

universe u
variable {R : Type u} [CommSemiring R] {a b : ℕ}

private theorem conductor_succ (ha : 1 < a) (hb : 1 < b) :
    a * b - a - b + 1 = (a - 1) * (b - 1) := by
  have hc : 0 < (a - 1) * (b - 1) := Nat.mul_pos (by omega) (by omega)
  simp only [Nat.sub_mul, Nat.mul_sub, Nat.one_mul, Nat.mul_one] at hc ⊢
  omega

private theorem mem_closure_of_conductor_le (h : a.Coprime b) {n : ℕ}
    (hn : (a - 1) * (b - 1) ≤ n) :
    n ∈ AddSubmonoid.closure ({a, b} : Set ℕ) := by
  by_cases ha : a = 1
  · subst a
    exact (AddSubmonoid.mem_closure_pair 1 b n).mpr ⟨n, 0, by simp⟩
  by_cases hb : b = 1
  · subst b
    exact (AddSubmonoid.mem_closure_pair a 1 n).mpr ⟨0, n, by simp⟩
  have ha0 : a ≠ 0 := by
    intro ha0
    subst a
    exact hb ((Nat.coprime_zero_left b).mp h)
  have hb0 : b ≠ 0 := by
    intro hb0
    subst b
    exact ha ((Nat.coprime_zero_right a).mp h)
  have ha' : 1 < a := by omega
  have hb' : 1 < b := by omega
  exact (frobeniusNumber_iff.mp (frobeniusNumber_pair h ha' hb')).2 n
    (by have := conductor_succ ha' hb'; omega)

/-- Over any commutative semiring, the ideal generated by
`X^((a - 1) * (b - 1))` is the greatest ambient polynomial ideal contained in
`R[X^a, X^b]`, when `a` and `b` are coprime. -/
theorem isGreatest_ideal_le_adjoin_X_pow_pair (h : a.Coprime b) :
    IsGreatest
      {I : Ideal R[X] | (I : Set R[X]) ⊆
        (Algebra.adjoin R ({X ^ a, X ^ b} : Set R[X]) : Set R[X])}
      (Ideal.span ({X ^ ((a - 1) * (b - 1))} : Set R[X])) := by
  constructor
  · intro p hp
    apply (mem_adjoin_X_pow_pair_iff p).mpr
    intro n hn
    apply mem_closure_of_conductor_le h
    by_contra hlt
    have hz := X_pow_dvd_iff.mp (Ideal.mem_span_singleton.mp hp) n (by omega)
    exact (mem_support_iff.mp hn) hz
  · intro I hI p hp
    apply Ideal.mem_span_singleton.mpr
    apply X_pow_dvd_iff.mpr
    intro n hn
    have ha : 1 < a := by
      by_contra hle
      have hz : a - 1 = 0 := by omega
      simp [hz] at hn
    have hb : 1 < b := by
      by_contra hle
      have hz : b - 1 = 0 := by omega
      simp [hz] at hn
    -- Move a coefficient below the conductor to the missing Frobenius degree.
    -- Multiplication by a power of `X` does not mix coefficients.
    have hF := conductor_succ ha hb
    have hnF : n ≤ a * b - a - b := by omega
    have hq := hI (I.mul_mem_right (X ^ (a * b - a - b - n)) hp)
    have hc : (p * X ^ (a * b - a - b - n)).coeff (a * b - a - b) = p.coeff n := by
      rw [coeff_mul_X_pow']
      simp [show a * b - a - b - n ≤ a * b - a - b by omega,
        show a * b - a - b - (a * b - a - b - n) = n by omega]
    by_contra hn0
    apply (frobeniusNumber_iff.mp (frobeniusNumber_pair h ha hb)).1
    apply (mem_adjoin_X_pow_pair_iff _).mp hq
    apply mem_support_iff.mpr
    simpa only [hc] using hn0

/-- Over any commutative semiring, the zero ideal is the greatest ambient
polynomial ideal contained in `R[X^a, X^b]` when `a` and `b` are not coprime.
This includes the case `a = b = 0` and the zero coefficient semiring. -/
theorem isGreatest_ideal_le_adjoin_X_pow_pair_of_not_coprime (h : ¬ Nat.Coprime a b) :
    IsGreatest
      {I : Ideal R[X] | (I : Set R[X]) ⊆
        (Algebra.adjoin R ({X ^ a, X ^ b} : Set R[X]) : Set R[X])}
      (⊥ : Ideal R[X]) := by
  constructor
  · intro p hp
    rw [Ideal.mem_bot.mp hp]
    exact Subalgebra.zero_mem _
  · intro I hI p hp
    have hd (q : R[X]) (hq : q ∈ Algebra.adjoin R ({X ^ a, X ^ b} : Set R[X]))
        {n : ℕ} (hn : n ∈ q.support) : Nat.gcd a b ∣ n := by
      obtain ⟨i, j, hij⟩ := (AddSubmonoid.mem_closure_pair a b n).mp
        ((mem_adjoin_X_pow_pair_iff q).mp hq n hn)
      simp only [Nat.nsmul_eq_mul] at hij
      rw [← hij]
      exact dvd_add (dvd_mul_of_dvd_right (Nat.gcd_dvd_left a b) i)
        (dvd_mul_of_dvd_right (Nat.gcd_dvd_right a b) j)
    rw [Ideal.mem_bot]
    ext n
    simp only [coeff_zero]
    by_contra hn
    -- A nonzero coefficient survives multiplication by X, so the gcd divides
    -- two consecutive degrees. No cancellation of coefficients is needed.
    have hn0 := hd p (hI hp) (mem_support_iff.mpr hn)
    have hn1 := hd (p * X) (hI (I.mul_mem_right X hp)) (n := n + 1)
      (mem_support_iff.mpr (by simpa only [coeff_mul_X] using hn))
    have h1 : Nat.gcd a b ∣ 1 := by
      simpa using Nat.dvd_sub hn1 hn0
    exact h (Nat.coprime_iff_gcd_eq_one.mpr (Nat.dvd_one.mp h1))

end Polynomial
