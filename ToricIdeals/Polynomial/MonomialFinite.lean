module

public import ToricIdeals.Polynomial.MonomialSubalgebra
public import ToricIdeals.Polynomial.FiniteSubalgebra
public import Mathlib.NumberTheory.FrobeniusNumber
public import Mathlib.RingTheory.IntegralClosure.Algebra.Basic

/-!
# Finite gcd extensions of monomial subalgebras

The subalgebra generated by powers with exponents in an additive submonoid `S` of
`ℕ` includes canonically into the subalgebra generated by multiples of its gcd.
The latter is a finite module over the former, for arbitrary commutative semiring
coefficients. With commutative ring coefficients the same extension is integral.
The scalar action is the one induced by the existing subalgebra inclusion.

The zero gcd case is the constants, not the whole polynomial ring. For a positive
gcd, power substitution identifies the target with a polynomial ring; the proof
pulls the source back through substitution and transports finiteness with the
commuting scalar square.

## References

This reuses the project's monomial-support, power-substitution and positive-power
finite-span developments. The transport uses Mathlib's subalgebra equivalences
(Kenny Lau and Yury Kudryashov), polynomial expansion (Kenny Lau), module finiteness
(Johan Commelin), set-gcd arithmetic (Alex Zhao, Daniel Buth, Sebastian Meier and
Junyan Xu), and the finite-implies-integral theorem (Kenny Lau).
-/

@[expose] public section

noncomputable section

universe u

namespace Polynomial

variable {R : Type u} [CommSemiring R]

/-- The exponent subalgebra includes in the subalgebra generated by multiples of
its gcd, over an arbitrary commutative semiring. -/
theorem adjoin_X_pow_le_adjoin_X_pow_setGcd (S : AddSubmonoid ℕ) :
    Algebra.adjoin R (Set.range fun s : S => (X : R[X]) ^ (s : ℕ)) ≤
      Algebra.adjoin R (Set.range fun s : AddSubmonoid.multiples (Nat.setGcd (S : Set ℕ)) =>
        (X : R[X]) ^ (s : ℕ)) := by
  apply Algebra.adjoin_le
  rintro _ ⟨s, rfl⟩
  obtain ⟨n, hn⟩ := Nat.setGcd_dvd_of_mem s.property
  apply Algebra.subset_adjoin
  refine ⟨⟨(s : ℕ), ?_⟩, rfl⟩
  exact (AddSubmonoid.mem_multiples_iff _ _).mpr
    ⟨n, by simpa [nsmul_eq_mul, Nat.mul_comm] using hn.symm⟩

variable (S : AddSubmonoid ℕ)

local notation "A" => Algebra.adjoin R (Set.range fun s : S => (X : R[X]) ^ (s : ℕ))
local notation "d" => Nat.setGcd (S : Set ℕ)
local notation "B" => Algebra.adjoin R
  (Set.range fun s : AddSubmonoid.multiples d => (X : R[X]) ^ (s : ℕ))

/-- The inclusion-induced algebra on the gcd monomial subalgebra. -/
local instance instAlgebraAdjoinXPowSetGcd : Algebra A B :=
  (Subalgebra.inclusion (adjoin_X_pow_le_adjoin_X_pow_setGcd (R := R) S)).toRingHom.toAlgebra

local instance : IsScalarTower R A B :=
  IsScalarTower.of_algebraMap_eq (fun _ => rfl)

local instance : IsScalarTower A B R[X] :=
  IsScalarTower.of_algebraMap_eq (fun _ => rfl)

/-- The gcd inclusion fixes coefficients. -/
theorem algebraMap_adjoin_X_pow_setGcd_coeff (r : R) :
    algebraMap A B (algebraMap R A r) = algebraMap R B r := rfl

/-- The gcd inclusion's scalar action is multiplication of ambient polynomials. -/
theorem coe_adjoin_X_pow_setGcd_smul (a : A) (b : B) :
    ((a • b : B) : R[X]) = (a : R[X]) * (b : R[X]) := by
  change (IsScalarTower.toAlgHom A B R[X]) (a • b) = _
  rw [map_smul, Algebra.smul_def]
  rfl

/-- The gcd monomial subalgebra is finite over the original exponent subalgebra,
for the canonical inclusion-induced action. No positivity or coefficient-domain
assumption is needed. -/
theorem moduleFinite_adjoin_X_pow_setGcd : Module.Finite A B := by
  classical
  by_cases hd : d = 0
  · have hBA : B ≤ A := by
      apply Algebra.adjoin_le
      rintro _ ⟨s, rfl⟩
      obtain ⟨n, hn⟩ := (AddSubmonoid.mem_multiples_iff (s : ℕ) d).mp s.property
      have hs : (s : ℕ) = 0 := by simpa [hd] using hn.symm
      change (X : R[X]) ^ (s : ℕ) ∈ A
      rw [hs, pow_zero]
      exact one_mem _
    apply Module.Finite.of_surjective (Algebra.linearMap A B)
    intro b
    exact ⟨⟨(b : R[X]), hBA b.property⟩, Subtype.ext rfl⟩
  · have hdpos : 0 < d := Nat.pos_of_ne_zero hd
    obtain ⟨a, ha, ha0⟩ := Nat.exists_ne_zero_of_setGcd_ne_zero hd
    obtain ⟨m, hm⟩ := Nat.setGcd_dvd_of_mem ha
    have hmpos : 0 < m := by
      apply Nat.pos_of_ne_zero
      intro hm0
      exact ha0 (by simpa [hm0] using hm)
    let A' : Subalgebra R R[X] := (A).comap (expand R d)
    have hpower : (X : R[X]) ^ m ∈ A' := by
      change expand R d (X ^ m) ∈ A
      rw [map_pow, expand_X, ← pow_mul, ← hm]
      exact Algebra.subset_adjoin ⟨⟨a, ha⟩, rfl⟩
    have : Module.Finite A' R[X] := moduleFinite_of_X_pow_mem A' hmpos hpower
    have hmap : A'.map (expand R d) = A := by
      apply le_antisymm
      · rintro p ⟨q, hq, rfl⟩
        exact hq
      · intro p hp
        have hpB : p ∈ B := adjoin_X_pow_le_adjoin_X_pow_setGcd (R := R) S hp
        rw [← range_expand_eq_adjoin_X_pow_multiples] at hpB
        obtain ⟨q, hq⟩ := hpB
        refine ⟨q, ?_, hq⟩
        change expand R d q ∈ A
        exact hq.symm ▸ hp
    let e₁ : A' ≃ₐ[R] A :=
      (Subalgebra.equivMapOfInjective A' (expand R d) (expand_injective hdpos)).trans
        (Subalgebra.equivOfEq _ _ hmap)
    let e₂ : R[X] ≃ₐ[R] B := expandEquivAdjoinXPow d hdpos
    have hsquare : (algebraMap A B).comp e₁.toRingEquiv.toRingHom =
        e₂.toRingEquiv.toRingHom.comp (algebraMap A' R[X]) := by
      apply RingHom.ext
      intro q
      apply Subtype.ext
      rfl
    exact Module.Finite.of_equiv_equiv e₁.toRingEquiv e₂.toRingEquiv hsquare

section Ring

variable {R : Type u} [CommRing R]

/-- Over commutative rings, every element of the gcd monomial subalgebra is
integral over the exponent subalgebra, with the canonical inclusion action. -/
theorem isIntegral_adjoin_X_pow_setGcd (S : AddSubmonoid ℕ)
    (b : Algebra.adjoin R (Set.range fun s : AddSubmonoid.multiples
      (Nat.setGcd (S : Set ℕ)) => (X : R[X]) ^ (s : ℕ))) :
    IsIntegral (Algebra.adjoin R (Set.range fun s : S => (X : R[X]) ^ (s : ℕ))) b := by
  have := moduleFinite_adjoin_X_pow_setGcd (R := R) S
  exact IsIntegral.of_finite _ b

end Ring

end Polynomial
