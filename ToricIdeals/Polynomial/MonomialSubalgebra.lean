module

public import Mathlib.Algebra.Polynomial.AlgebraMap
public import Mathlib.Algebra.Polynomial.Basis
public import Mathlib.Algebra.Polynomial.Expand
public import Mathlib.LinearAlgebra.FreeModule.Basic
import Mathlib.Algebra.MonoidAlgebra.Support
import Mathlib.LinearAlgebra.Finsupp.Supported

/-!
# Polynomial subalgebras generated by monomial powers

For an additive submonoid `S` of the natural numbers, the `R`-subalgebra generated
by `X ^ n` for `n ∈ S` consists exactly of polynomials whose coefficients outside
`S` vanish. The coefficient semiring is an arbitrary commutative semiring.

The two-generator support characterization is recovered using the equality of
the adjoin generated by two powers and the adjoin indexed by their additive closure.
The monomial basis restricts to this subalgebra, indexed by the admissible exponents,
with polynomial coefficients as its coordinates and a finite reconstruction formula.
Freeness of its canonical module follows from
`Module.Free.of_basis (basisAdjoinXPow (R := R) S)`.

Power substitution has range the subalgebra whose exponents are multiples of the
substitution degree, including degree zero. For a positive degree this gives an
algebra equivalence from the polynomial ring, with inverse coefficients read at
the corresponding multiples of that degree.
At degree zero the exponent subalgebra is the bottom coefficient subalgebra;
its coefficient equivalence works without a nontriviality assumption.

## References

The proof generalizes the support argument from the toric-ideals polynomial
conductor development. It uses Mathlib's supported-submodule membership API
(`Mathlib.Algebra.MonoidAlgebra.Module`), multiplication support bounds
(`Mathlib.Algebra.MonoidAlgebra.Support`), and polynomial monomial expansion.
The basis construction uses Mathlib's polynomial monomial basis (Jz Pan),
supported-coordinate equivalence, and `Module.Basis.ofRepr`. The power-substitution
construction uses Mathlib's `Polynomial.expand` API (Kenny Lau) and the generic
`AlgEquiv.ofInjective` and `Subalgebra.equivOfEq` equivalences.
-/

@[expose] public section

namespace Polynomial

universe u
variable {R : Type u} [CommSemiring R]

/-- A polynomial belongs to the subalgebra generated by powers with exponents in
an additive submonoid exactly when its coefficients outside that submonoid vanish. -/
theorem mem_adjoin_X_pow_iff (S : AddSubmonoid ℕ) (p : R[X]) :
    p ∈ Algebra.adjoin R (Set.range fun s : S => (X : R[X]) ^ (s : ℕ)) ↔
      ∀ n : ℕ, n ∉ S → p.coeff n = 0 := by
  have hsupp : (↑p.support : Set ℕ) ⊆ S ↔ ∀ n : ℕ, n ∉ S → p.coeff n = 0 := by
    simpa only [toFinsupp_apply, support_toFinsupp, SetLike.mem_coe] using
      (AddMonoidAlgebra.mem_supported (R := R) (S := R) (s := (S : Set ℕ))
        (x := p.toFinsupp)).symm.trans AddMonoidAlgebra.mem_supported'
  rw [← hsupp]
  change _ ↔ ∀ n ∈ p.support, n ∈ S
  constructor
  · intro hp
    refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hp
    · rintro _ ⟨s, rfl⟩ n hn
      have hns : n = (s : ℕ) := by
        by_contra h
        exact (mem_support_iff.mp hn) (by simp [coeff_X_pow, h])
      subst n
      exact s.property
    · intro r n hn
      have hn0 : n = 0 := Finset.mem_singleton.mp (support_C_subset r hn)
      subst n
      exact S.zero_mem
    · intro x y hx hy ihx ihy n hn
      rcases Finset.mem_union.mp (support_add hn) with hn | hn
      · exact ihx n hn
      · exact ihy n hn
    · intro x y hx hy ihx ihy n hn
      have hn' : n ∈ (x.toFinsupp * y.toFinsupp).coeff.support := by
        rw [← toFinsupp_mul]
        exact hn
      obtain ⟨i, hi, j, hj, rfl⟩ := Finset.mem_add.mp
        (AddMonoidAlgebra.support_coeff_mul_subset x.toFinsupp y.toFinsupp hn')
      exact S.add_mem (ihx i hi) (ihy j hj)
  · intro hp
    rw [← p.sum_monomial_eq, sum_def]
    apply Subalgebra.sum_mem
    intro n hn
    rw [← C_mul_X_pow_eq_monomial]
    exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _)
      (Algebra.subset_adjoin ⟨⟨n, hp n hn⟩, rfl⟩)

/-- A power of `X` lies in the monomial subalgebra exactly when its exponent
belongs to the generating additive submonoid. -/
@[simp]
theorem X_pow_mem_adjoin_X_pow_iff [Nontrivial R] (S : AddSubmonoid ℕ) (n : ℕ) :
    (X : R[X]) ^ n ∈ Algebra.adjoin R
      (Set.range fun s : S => (X : R[X]) ^ (s : ℕ)) ↔ n ∈ S := by
  constructor
  · intro h
    by_contra hn
    have hc := (mem_adjoin_X_pow_iff S _).mp h n hn
    exact one_ne_zero ((coeff_X_pow_self n).symm.trans hc)
  · intro hn
    exact Algebra.subset_adjoin ⟨⟨n, hn⟩, rfl⟩

/-- Passing from two exponents to their additive closure does not change the
subalgebra generated by the corresponding powers of `X`. -/
theorem adjoin_X_pow_closure_pair_eq (a b : ℕ) :
    Algebra.adjoin R (Set.range fun s : AddSubmonoid.closure ({a, b} : Set ℕ) =>
      (X : R[X]) ^ (s : ℕ)) = Algebra.adjoin R ({X ^ a, X ^ b} : Set R[X]) := by
  apply le_antisymm
  · apply Algebra.adjoin_le
    rintro _ ⟨s, rfl⟩
    refine AddSubmonoid.closure_induction
      (motive := fun n _ => (X : R[X]) ^ n ∈
        Algebra.adjoin R ({X ^ a, X ^ b} : Set R[X])) ?_ ?_ ?_ s.property
    · intro n hn
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hn
      rcases hn with rfl | rfl
      · exact Algebra.subset_adjoin (by simp)
      · exact Algebra.subset_adjoin (by simp)
    · simpa only [pow_zero] using
        (Algebra.adjoin R ({X ^ a, X ^ b} : Set R[X])).one_mem
    · intro i j hi hj ihx ihy
      rw [pow_add]
      exact Subalgebra.mul_mem _ ihx ihy
  · apply Algebra.adjoin_le
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · exact Algebra.subset_adjoin
        ⟨⟨a, AddSubmonoid.subset_closure (by simp)⟩, rfl⟩
    · exact Algebra.subset_adjoin
        ⟨⟨b, AddSubmonoid.subset_closure (by simp)⟩, rfl⟩

/-- Membership in the subalgebra generated by two powers of `X` is characterized
by the additive submonoid containing all exponents in the support. -/
theorem mem_adjoin_X_pow_pair_iff {a b : ℕ} (p : R[X]) :
    p ∈ Algebra.adjoin R ({X ^ a, X ^ b} : Set R[X]) ↔
      ∀ n ∈ p.support, n ∈ AddSubmonoid.closure ({a, b} : Set ℕ) := by
  rw [← adjoin_X_pow_closure_pair_eq, mem_adjoin_X_pow_iff]
  simpa only [toFinsupp_apply, support_toFinsupp, Set.subset_def, SetLike.mem_coe] using
    (AddMonoidAlgebra.mem_supported' (R := R) (S := R)
      (s := (AddSubmonoid.closure ({a, b} : Set ℕ) : Set ℕ))
      (x := p.toFinsupp)).symm.trans AddMonoidAlgebra.mem_supported

/-- The basis of the polynomial subalgebra generated by powers with exponents in `S`.
Its vectors are the admissible powers of `X`, and its coordinates are polynomial coefficients. -/
noncomputable def basisAdjoinXPow (S : AddSubmonoid ℕ) :
    Module.Basis S R
      ↥(Algebra.adjoin R (Set.range fun s : S => (X : R[X]) ^ (s : ℕ))) :=
  let e : ↥(Algebra.adjoin R (Set.range fun s : S => (X : R[X]) ^ (s : ℕ))) ≃ₗ[R]
      Finsupp.supported R R (S : Set ℕ) :=
    { toFun p := ⟨(basisMonomials R).repr (p : R[X]), by
        rw [Finsupp.mem_supported']
        exact (mem_adjoin_X_pow_iff S (p : R[X])).mp p.property⟩
      invFun c := ⟨(basisMonomials R).repr.symm (c : ℕ →₀ R), by
        rw [mem_adjoin_X_pow_iff]
        intro n hn
        change ((basisMonomials R).repr
          ((basisMonomials R).repr.symm (c : ℕ →₀ R))) n = 0
        rw [LinearEquiv.apply_symm_apply]
        exact (Finsupp.mem_supported' _ _).mp c.property n hn⟩
      left_inv p := Subtype.ext ((basisMonomials R).repr.symm_apply_apply (p : R[X]))
      right_inv c := Subtype.ext ((basisMonomials R).repr.apply_symm_apply (c : ℕ →₀ R))
      map_add' p q := Subtype.ext ((basisMonomials R).repr.map_add (p : R[X]) (q : R[X]))
      map_smul' r p := Subtype.ext ((basisMonomials R).repr.map_smul r (p : R[X])) }
  Module.Basis.ofRepr (e.trans
    (Finsupp.supportedEquivFinsupp (R := R) (M := R) (S : Set ℕ)))

/-- The vector indexed by an admissible exponent is the corresponding power of `X`. -/
@[simp]
theorem coe_basisAdjoinXPow (S : AddSubmonoid ℕ) (s : S) :
    ((basisAdjoinXPow (R := R) S s :
      Algebra.adjoin R (Set.range fun t : S => (X : R[X]) ^ (t : ℕ))) : R[X]) =
        X ^ (s : ℕ) := by
  change (basisMonomials R).repr.symm
    (((Finsupp.supportedEquivFinsupp (R := R) (M := R) (S : Set ℕ)).symm
      (Finsupp.single s 1)) : ℕ →₀ R) = _
  rw [Finsupp.supportedEquivFinsupp_symm_single]
  change basisMonomials R (s : ℕ) = _
  rw [coe_basisMonomials]
  exact monomial_one_right_eq_X_pow _

/-- Coordinates in the admissible-power basis are the polynomial coefficients. -/
@[simp]
theorem basisAdjoinXPow_repr (S : AddSubmonoid ℕ)
    (p : Algebra.adjoin R (Set.range fun s : S => (X : R[X]) ^ (s : ℕ))) (s : S) :
    (basisAdjoinXPow (R := R) S).repr p s = (p : R[X]).coeff (s : ℕ) := by
  rfl

/-- Reconstruct a polynomial in the exponent subalgebra from its admissible coordinates. -/
theorem sum_basisAdjoinXPow_repr (S : AddSubmonoid ℕ)
    (p : Algebra.adjoin R (Set.range fun s : S => (X : R[X]) ^ (s : ℕ))) :
    ((basisAdjoinXPow (R := R) S).repr p).sum (fun s r => C r * X ^ (s : ℕ)) =
      (p : R[X]) := by
  have h := congrArg
    (Subalgebra.val (Algebra.adjoin R
      (Set.range fun s : S => (X : R[X]) ^ (s : ℕ)))).toLinearMap
    ((basisAdjoinXPow (R := R) S).linearCombination_repr p)
  simpa [Finsupp.linearCombination_apply, Finsupp.sum, smul_eq_C_mul] using h

/-- The range of power substitution is the subalgebra generated by powers whose
exponents are natural multiples of the substitution degree, including degree zero. -/
theorem range_expand_eq_adjoin_X_pow_multiples (d : ℕ) :
    (expand R d).range = Algebra.adjoin R
      (Set.range fun s : AddSubmonoid.multiples d => (X : R[X]) ^ (s : ℕ)) := by
  apply le_antisymm
  · rintro _ ⟨p, rfl⟩
    induction p using Polynomial.induction_on' with
    | add p q hp hq =>
        simpa only [map_add] using Subalgebra.add_mem _ hp hq
    | monomial n r =>
        change expand R d (monomial n r) ∈ _
        rw [expand_monomial, ← C_mul_X_pow_eq_monomial]
        refine Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ r) ?_
        exact Algebra.subset_adjoin
          ⟨⟨n * d, (AddSubmonoid.mem_multiples_iff (n * d) d).mpr
            ⟨n, by simp⟩⟩, rfl⟩
  · apply Algebra.adjoin_le
    rintro _ ⟨s, rfl⟩
    obtain ⟨n, hn⟩ := (AddSubmonoid.mem_multiples_iff (s : ℕ) d).mp s.property
    refine ⟨X ^ n, ?_⟩
    change expand R d (X ^ n) = (X : R[X]) ^ (s : ℕ)
    rw [map_pow, expand_X, ← pow_mul]
    exact congrArg (fun k => (X : R[X]) ^ k)
      ((Nat.mul_comm d n).trans (by simpa [nsmul_eq_mul] using hn))

/-- Positive-degree power substitution identifies the polynomial ring with the
existing subalgebra generated by the powers with exponents in `multiples d`. -/
noncomputable def expandEquivAdjoinXPow (d : ℕ) (hd : 0 < d) :
    R[X] ≃ₐ[R] ↥(Algebra.adjoin R
      (Set.range fun s : AddSubmonoid.multiples d => (X : R[X]) ^ (s : ℕ))) :=
  (AlgEquiv.ofInjective (expand R d) (expand_injective hd)).trans
    (Subalgebra.equivOfEq _ _ (range_expand_eq_adjoin_X_pow_multiples d))

/-- The ambient polynomial of the substitution equivalence is power substitution. -/
@[simp]
theorem coe_expandEquivAdjoinXPow_apply (d : ℕ) (hd : 0 < d) (p : R[X]) :
    (expandEquivAdjoinXPow (R := R) d hd p : R[X]) = expand R d p :=
  rfl

/-- The inverse substitution equivalence reads coefficients at multiples of the degree. -/
@[simp]
theorem coeff_expandEquivAdjoinXPow_symm (d : ℕ) (hd : 0 < d)
    (p : Algebra.adjoin R
      (Set.range fun s : AddSubmonoid.multiples d => (X : R[X]) ^ (s : ℕ))) (n : ℕ) :
    ((expandEquivAdjoinXPow (R := R) d hd).symm p).coeff n =
      (p : R[X]).coeff (n * d) := by
  have h := congrArg (fun f : R[X] => f.coeff (n * d))
    (coe_expandEquivAdjoinXPow_apply d hd ((expandEquivAdjoinXPow d hd).symm p))
  simpa only [AlgEquiv.apply_symm_apply, coeff_expand_mul hd] using h.symm

/-- Powers whose exponents are multiples of zero generate only the coefficients. -/
@[simp]
theorem adjoin_X_pow_multiples_zero :
    Algebra.adjoin R
      (Set.range fun s : AddSubmonoid.multiples (0 : ℕ) => (X : R[X]) ^ (s : ℕ)) =
        (⊥ : Subalgebra R R[X]) := by
  apply le_antisymm _ bot_le
  apply Algebra.adjoin_le
  rintro _ ⟨s, rfl⟩
  obtain ⟨n, hn⟩ := (AddSubmonoid.mem_multiples_iff (s : ℕ) 0).mp s.property
  have hs : (s : ℕ) = 0 := by simpa using hn.symm
  change (X : R[X]) ^ (s : ℕ) ∈ (⊥ : Subalgebra R R[X])
  rw [hs, pow_zero]
  exact (⊥ : Subalgebra R R[X]).one_mem

/-- The degree-zero exponent subalgebra is canonically the coefficient semiring. -/
noncomputable def adjoinXPowZeroEquiv :
    ↥(Algebra.adjoin R
      (Set.range fun s : AddSubmonoid.multiples (0 : ℕ) => (X : R[X]) ^ (s : ℕ))) ≃ₐ[R] R :=
  (Subalgebra.equivOfEq _ _ (adjoin_X_pow_multiples_zero (R := R))).trans
    (Algebra.botEquivOfInjective (R := R) (A := R[X]) C_injective)

/-- The inverse coefficient equivalence includes a coefficient as a constant polynomial. -/
@[simp]
theorem coe_adjoinXPowZeroEquiv_symm_apply (r : R) :
    ((adjoinXPowZeroEquiv (R := R)).symm r : R[X]) = C r := by
  simpa using congrArg
    (fun p : Algebra.adjoin R
      (Set.range fun s : AddSubmonoid.multiples (0 : ℕ) => (X : R[X]) ^ (s : ℕ)) =>
        (p : R[X])) ((adjoinXPowZeroEquiv (R := R)).symm.commutes r)

/-- The coefficient equivalence reads the constant coefficient. -/
@[simp]
theorem adjoinXPowZeroEquiv_apply
    (p : Algebra.adjoin R
      (Set.range fun s : AddSubmonoid.multiples (0 : ℕ) => (X : R[X]) ^ (s : ℕ))) :
    adjoinXPowZeroEquiv p = (p : R[X]).coeff 0 := by
  have h := congrArg (fun q : R[X] => q.coeff 0)
    (coe_adjoinXPowZeroEquiv_symm_apply (adjoinXPowZeroEquiv p))
  simpa using h.symm

end Polynomial
