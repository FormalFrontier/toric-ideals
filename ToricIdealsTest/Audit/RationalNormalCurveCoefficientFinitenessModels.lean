module

import Mathlib.Algebra.Ring.ULift
import Mathlib.Data.ZMod.Basic
import Mathlib.RingTheory.Finiteness.Basic
import Mathlib.RingTheory.Polynomial.Basic
import ToricIdeals.RationalNormalCurve.AxisProjection

/-!
# Coefficient-module finiteness boundaries for full Hankel quotients

These examples use the canonical coefficient action on
`Source R n ⧸ hankelIdeal R n`. In degree zero, the integer quotient retains a
polynomial indeterminate and is not finite over the integers. In degree two,
`ZMod 4` gives another nonfinite coefficient module, with a surviving nonzero
square-zero constant. Zero coefficients give finite modules in both degrees.
A lifted copy of `ZMod 4` tests the coefficient action in a higher universe.

The negative examples use the coefficient-linear axis projection onto the
full univariate polynomial ring and Mathlib's polynomial obstruction. They do
not replace the quotient by a parametrization image, use a quotient finiteness
criterion, or infer finite generation from a chain condition. The scalar ring
is `R`, not the polynomial algebra generated by endpoint coordinates.

## References

* Formal Frontier Agents, `ToricIdeals.RationalNormalCurve.AxisProjection`, for
  the coefficient-preserving split projection of the full Hankel quotient.
* Mathlib contributors, `Mathlib.RingTheory.Polynomial.Basic` and
  `Mathlib.RingTheory.Finiteness.Basic`, for the polynomial obstruction and
  surjective-image finiteness.
* Formal Frontier Agents, `ToricIdealsTest.RationalNormalCurveCoefficientModules`,
  for coefficient-linear axis consumers and lifted nonreduced coefficients.
-/

namespace ToricIdeals.RationalNormalCurve.CoefficientFinitenessModels

noncomputable section

universe u

/-- The degree-zero integer quotient is the full polynomial ring, not constants,
and is not finite for the canonical integer action. -/
private theorem integer_degree_zero_quotient_not_finite :
    hankelIdeal ℤ 0 = ⊥ ∧ Function.Bijective (axisProjection ℤ 0) ∧
      axisProjection ℤ 0
        (Ideal.Quotient.mk (hankelIdeal ℤ 0) (MvPolynomial.X (0 : Fin 1))) =
        Polynomial.X ∧
      ¬ Module.Finite ℤ (Source ℤ 0 ⧸ hankelIdeal ℤ 0) := by
  refine ⟨hankelIdeal_zero ℤ, axisProjection_bijective_zero ℤ,
    axisProjection_X_zero ℤ 0, ?_⟩
  intro hQ
  let : Module.Finite ℤ (Source ℤ 0 ⧸ hankelIdeal ℤ 0) := hQ
  have hP : Module.Finite ℤ (Polynomial ℤ) :=
    Module.Finite.of_surjective (axisProjection ℤ 0).toLinearMap
      (axisProjection_surjective ℤ 0)
  exact Polynomial.not_finite hP

/-- A degree-two quotient over nonreduced coefficients is not a finite coefficient
module; its constant class of `2` is nonzero and square-zero. -/
private theorem mod_four_degree_two_quotient_with_nilpotent :
    ¬ Module.Finite (ZMod 4) (Source (ZMod 4) 2 ⧸ hankelIdeal (ZMod 4) 2) ∧
      algebraMap (ZMod 4) (Source (ZMod 4) 2 ⧸ hankelIdeal (ZMod 4) 2) 2 ≠ 0 ∧
      (algebraMap (ZMod 4) (Source (ZMod 4) 2 ⧸ hankelIdeal (ZMod 4) 2) 2) ^ 2 = 0 := by
  let : Fact (1 < 4) := ⟨by decide⟩
  have hne : (2 : ZMod 4) ≠ 0 := by decide
  have hsq : (2 : ZMod 4) ^ 2 = 0 := by decide
  refine ⟨?_, ?_, ?_⟩
  · intro hQ
    let : Module.Finite (ZMod 4)
        (Source (ZMod 4) 2 ⧸ hankelIdeal (ZMod 4) 2) := hQ
    have hP : Module.Finite (ZMod 4) (Polynomial (ZMod 4)) :=
      Module.Finite.of_surjective (axisProjection (ZMod 4) 2).toLinearMap
        (axisProjection_surjective (ZMod 4) 2)
    exact Polynomial.not_finite hP
  · intro hzero
    have hconst : Polynomial.C (2 : ZMod 4) = 0 := by
      simpa only [axisProjection_algebraMap, map_zero] using
        congrArg (axisProjection (ZMod 4) 2) hzero
    apply hne
    simpa only [Polynomial.coeff_C_zero, Polynomial.coeff_zero] using
      congrArg (fun p : Polynomial (ZMod 4) => p.coeff 0) hconst
  · rw [← map_pow, hsq, map_zero]

/-- Zero coefficients give finite coefficient modules in degrees zero and two. -/
private theorem zero_coefficients_degree_zero_and_two_finite :
    Module.Finite (ZMod 1) (Source (ZMod 1) 0 ⧸ hankelIdeal (ZMod 1) 0) ∧
      Module.Finite (ZMod 1) (Source (ZMod 1) 2 ⧸ hankelIdeal (ZMod 1) 2) := by
  constructor
  · let : Subsingleton (Source (ZMod 1) 0 ⧸ hankelIdeal (ZMod 1) 0) :=
      Module.subsingleton (ZMod 1) (Source (ZMod 1) 0 ⧸ hankelIdeal (ZMod 1) 0)
    let : Finite (Source (ZMod 1) 0 ⧸ hankelIdeal (ZMod 1) 0) := inferInstance
    exact Module.Finite.of_finite
  · let : Subsingleton (Source (ZMod 1) 2 ⧸ hankelIdeal (ZMod 1) 2) :=
      Module.subsingleton (ZMod 1) (Source (ZMod 1) 2 ⧸ hankelIdeal (ZMod 1) 2)
    let : Finite (Source (ZMod 1) 2 ⧸ hankelIdeal (ZMod 1) 2) := inferInstance
    exact Module.Finite.of_finite

/-- Lifting the coefficient universe preserves the degree-two obstruction. -/
private theorem lifted_mod_four_degree_two_quotient_not_finite :
    ¬ Module.Finite (ULift.{u + 1} (ZMod 4))
      (Source (ULift.{u + 1} (ZMod 4)) 2 ⧸
        hankelIdeal (ULift.{u + 1} (ZMod 4)) 2) := by
  let : Fact (1 < 4) := ⟨by decide⟩
  intro hQ
  let : Module.Finite (ULift.{u + 1} (ZMod 4))
      (Source (ULift.{u + 1} (ZMod 4)) 2 ⧸
        hankelIdeal (ULift.{u + 1} (ZMod 4)) 2) := hQ
  have hP : Module.Finite (ULift.{u + 1} (ZMod 4))
      (Polynomial (ULift.{u + 1} (ZMod 4))) :=
    Module.Finite.of_surjective (axisProjection (ULift.{u + 1} (ZMod 4)) 2).toLinearMap
      (axisProjection_surjective (ULift.{u + 1} (ZMod 4)) 2)
  exact Polynomial.not_finite hP

end

end ToricIdeals.RationalNormalCurve.CoefficientFinitenessModels
