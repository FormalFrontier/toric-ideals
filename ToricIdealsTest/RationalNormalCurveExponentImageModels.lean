module

public import Mathlib.Algebra.Group.Submonoid.Operations
public import Mathlib.Data.Finsupp.Single
import Mathlib.Tactic.FinCases
public import ToricIdeals.RationalNormalCurve

/-!
# Natural exponent models for rational normal curves

The zero source has zero image in every degree. At degree zero every source
exponent has zero image, and `(1,0)` is excluded. At degree one the exponent
map is the identity, including on the mixed target `(2,3)`.

For the conic, the interior column gives `(1,1)`, and a sum of the first two
columns gives `(3,1)`, while `(1,0)` is excluded. For the twisted cubic, an
interior column gives `(2,1)`, adjacent columns give `(3,3)`, and separated
columns give `(4,2)`, while `(1,1)` is excluded. The mixed images show that
individual coordinates need not be divisible by the parametrization degree;
the interior conic column cannot be generated by the two endpoint columns.

## Limitations

These calculations use the singleton, additive, degree-one and total-exponent
laws of `ToricIdeals.RationalNormalCurve`. They do not use a classification of
all target exponents. Negative cases follow from the total-exponent law and
natural-number divisibility. All exponents are natural-valued; no coefficient
ring is involved.

## References

* Formal Frontier Agents, `ToricIdeals.RationalNormalCurve`, for the exponent
  map and its singleton, degree-one and total-exponent API.
* Mathlib contributors, for `Finsupp.single`, additive homomorphism laws and
  `AddMonoidHom.mem_mrange`.
-/

open ToricIdeals.RationalNormalCurve

namespace ToricIdeals.RationalNormalCurve.ExponentImageModels

noncomputable section

private def targetPair (a b : ℕ) : Fin 2 →₀ ℕ :=
  Finsupp.single (0 : Fin 2) a + Finsupp.single (1 : Fin 2) b

private def conicInteriorSource : Fin (2 + 1) →₀ ℕ :=
  Finsupp.single ⟨1, by decide⟩ 1

private def conicMixedSource : Fin (2 + 1) →₀ ℕ :=
  Finsupp.single ⟨0, by decide⟩ 1 + conicInteriorSource

private def cubicColumnSource : Fin (3 + 1) →₀ ℕ :=
  Finsupp.single ⟨1, by decide⟩ 1

private def cubicAdjacentSource : Fin (3 + 1) →₀ ℕ :=
  cubicColumnSource + Finsupp.single ⟨2, by decide⟩ 1

private def cubicSeparatedSource : Fin (3 + 1) →₀ ℕ :=
  Finsupp.single ⟨0, by decide⟩ 1 + Finsupp.single ⟨2, by decide⟩ 1

private theorem zero_source_image_and_membership (n : ℕ) :
    rncExponent n 0 = 0 ∧
      (0 : Fin 2 →₀ ℕ) ∈ AddMonoidHom.mrange (rncExponent n) := by
  exact ⟨map_zero (rncExponent n),
    AddMonoidHom.mem_mrange.mpr ⟨0, map_zero (rncExponent n)⟩⟩

private theorem degree_zero_all_source_images (d : Fin (0 + 1) →₀ ℕ) :
    rncExponent 0 d = 0 := by
  have htotal := rncExponent_total 0 d
  simp only [Nat.zero_mul] at htotal
  have hz0 : rncExponent 0 d 0 = 0 := by omega
  have hz1 : rncExponent 0 d 1 = 0 := by omega
  ext i
  fin_cases i
  · simpa using hz0
  · simpa using hz1

private theorem degree_zero_nonzero_target_excluded :
    targetPair 1 0 ∉ AddMonoidHom.mrange (rncExponent 0) := by
  intro hmem
  obtain ⟨d, hd⟩ := AddMonoidHom.mem_mrange.mp hmem
  have htotal := rncExponent_total 0 d
  rw [hd] at htotal
  simp [targetPair] at htotal

private theorem degree_one_identity (t : Fin 2 →₀ ℕ) :
    rncExponent 1 t = t :=
  rncExponent_one t

private theorem degree_one_mixed_target :
    targetPair 2 3 ∈ AddMonoidHom.mrange (rncExponent 1) := by
  exact AddMonoidHom.mem_mrange.mpr
    ⟨targetPair 2 3, rncExponent_one (targetPair 2 3)⟩

/-- The interior conic column has exponent `(1,1)` and witnesses its membership
in the additive image of the degree-two exponent map. -/
public theorem conic_interior_image_and_membership :
    rncExponent 2 (Finsupp.single (1 : Fin 3) 1) =
        (Finsupp.single (0 : Fin 2) 1 + Finsupp.single (1 : Fin 2) 1) ∧
      (Finsupp.single (0 : Fin 2) 1 + Finsupp.single (1 : Fin 2) 1) ∈
        AddMonoidHom.mrange (rncExponent 2) := by
  change rncExponent 2 conicInteriorSource = targetPair 1 1 ∧
    targetPair 1 1 ∈ AddMonoidHom.mrange (rncExponent 2)
  have himage : rncExponent 2 conicInteriorSource = targetPair 1 1 := by
    rw [conicInteriorSource, rncExponent_single]
    ext i
    fin_cases i <;> simp [coordinateExponent, targetPair]
  exact ⟨himage, AddMonoidHom.mem_mrange.mpr ⟨conicInteriorSource, himage⟩⟩

private theorem conic_mixed_image_and_membership :
    rncExponent 2 conicMixedSource = targetPair 3 1 ∧
      targetPair 3 1 ∈ AddMonoidHom.mrange (rncExponent 2) := by
  have himage : rncExponent 2 conicMixedSource = targetPair 3 1 := by
    simp only [conicMixedSource, conicInteriorSource, map_add, rncExponent_single]
    ext i
    fin_cases i <;> simp [coordinateExponent, targetPair]
  exact ⟨himage, AddMonoidHom.mem_mrange.mpr ⟨conicMixedSource, himage⟩⟩

private theorem conic_odd_total_target_excluded :
    targetPair 1 0 ∉ AddMonoidHom.mrange (rncExponent 2) := by
  intro hmem
  obtain ⟨d, hd⟩ := AddMonoidHom.mem_mrange.mp hmem
  have htotal := rncExponent_total 2 d
  rw [hd] at htotal
  have hdvd : (2 : ℕ) ∣ 1 :=
    ⟨sourceDegree 2 d, by simpa [targetPair] using htotal⟩
  exact (by decide : ¬ (2 : ℕ) ∣ 1) hdvd

private theorem cubic_column_image_and_membership :
    rncExponent 3 cubicColumnSource = targetPair 2 1 ∧
      targetPair 2 1 ∈ AddMonoidHom.mrange (rncExponent 3) := by
  have himage : rncExponent 3 cubicColumnSource = targetPair 2 1 := by
    rw [cubicColumnSource, rncExponent_single]
    ext i
    fin_cases i <;> simp [coordinateExponent, targetPair]
  exact ⟨himage, AddMonoidHom.mem_mrange.mpr ⟨cubicColumnSource, himage⟩⟩

private theorem cubic_adjacent_image_and_membership :
    rncExponent 3 cubicAdjacentSource = targetPair 3 3 ∧
      targetPair 3 3 ∈ AddMonoidHom.mrange (rncExponent 3) := by
  have himage : rncExponent 3 cubicAdjacentSource = targetPair 3 3 := by
    simp only [cubicAdjacentSource, cubicColumnSource, map_add, rncExponent_single]
    ext i
    fin_cases i <;> simp [coordinateExponent, targetPair]
  exact ⟨himage, AddMonoidHom.mem_mrange.mpr ⟨cubicAdjacentSource, himage⟩⟩

private theorem cubic_separated_image_and_membership :
    rncExponent 3 cubicSeparatedSource = targetPair 4 2 ∧
      targetPair 4 2 ∈ AddMonoidHom.mrange (rncExponent 3) := by
  have himage : rncExponent 3 cubicSeparatedSource = targetPair 4 2 := by
    simp only [cubicSeparatedSource, map_add, rncExponent_single]
    ext i
    fin_cases i <;> simp [coordinateExponent, targetPair]
  exact ⟨himage, AddMonoidHom.mem_mrange.mpr ⟨cubicSeparatedSource, himage⟩⟩

private theorem cubic_total_two_target_excluded :
    targetPair 1 1 ∉ AddMonoidHom.mrange (rncExponent 3) := by
  intro hmem
  obtain ⟨d, hd⟩ := AddMonoidHom.mem_mrange.mp hmem
  have htotal := rncExponent_total 3 d
  rw [hd] at htotal
  have hdvd : (3 : ℕ) ∣ 2 :=
    ⟨sourceDegree 3 d, by simpa [targetPair] using htotal⟩
  exact (by decide : ¬ (3 : ℕ) ∣ 2) hdvd

#print axioms targetPair
#print axioms conicInteriorSource
#print axioms conicMixedSource
#print axioms cubicColumnSource
#print axioms cubicAdjacentSource
#print axioms cubicSeparatedSource
#print axioms zero_source_image_and_membership
#print axioms degree_zero_all_source_images
#print axioms degree_zero_nonzero_target_excluded
#print axioms degree_one_identity
#print axioms degree_one_mixed_target
#print axioms conic_interior_image_and_membership
#print axioms conic_mixed_image_and_membership
#print axioms conic_odd_total_target_excluded
#print axioms cubic_column_image_and_membership
#print axioms cubic_adjacent_image_and_membership
#print axioms cubic_separated_image_and_membership
#print axioms cubic_total_two_target_excluded

end

end ToricIdeals.RationalNormalCurve.ExponentImageModels
