module

import Mathlib.Algebra.Ring.Pi
import Mathlib.Data.ZMod.Basic
import Mathlib.RingTheory.Ideal.Maps
import Mathlib.RingTheory.Noetherian.Defs
import ToricIdeals.RationalNormalCurve.Noetherian

/-!
# A non-Noetherian coefficient ring for rational normal curves

The pointwise commutative ring `ℕ → ZMod 2` has an ascending chain of ideals
generated by its first finitely many coordinate units. Evaluation at the next
coordinate vanishes on every earlier generator but takes that coordinate unit
to `1`. Thus every successive ideal inclusion is strict, and the ring is not
Noetherian.

The coordinate-unit argument establishes the coefficient-ring obstruction
independently of the Hankel quotient. Applying the Noetherian quotient criterion
then shows that the Hankel quotient over this ring is not Noetherian in any
degree. At degree zero this is the one-variable polynomial quotient by the
zero ideal, not the parametrization image.

## References

The elementary coordinate-unit argument uses Mathlib's `Pi.single`, pointwise
ring instances, `Pi.evalRingHom`, ideal span and kernel APIs, and the ascending-chain
characterization `monotone_stabilizes_iff_noetherian`.
The quotient consequence uses Formal Frontier Agents,
`ToricIdeals.RationalNormalCurve.Noetherian`, for the Hankel quotient criterion.
-/

public section

open ToricIdeals.RationalNormalCurve

namespace ToricIdealsTest.RationalNormalCurve

private def finiteCoordinateIdeal (N : ℕ) : Ideal (ℕ → ZMod 2) :=
  Ideal.span {f : ℕ → ZMod 2 | ∃ i : ℕ, i < N ∧ f = Pi.single i 1}

private theorem finiteCoordinateIdeal_monotone : Monotone finiteCoordinateIdeal := by
  intro M N hMN
  apply Ideal.span_mono
  rintro f ⟨i, hi, rfl⟩
  exact ⟨i, lt_of_lt_of_le hi hMN, rfl⟩

private theorem finiteCoordinateIdeal_le_eval_ker (N : ℕ) :
    finiteCoordinateIdeal N ≤ RingHom.ker (Pi.evalRingHom (fun _ : ℕ ↦ ZMod 2) N) := by
  apply Ideal.span_le.mpr
  rintro f ⟨i, hi, rfl⟩
  change (Pi.single i 1 : ℕ → ZMod 2) N = 0
  rw [Pi.single_eq_of_ne hi.ne.symm]

private theorem coordinateUnit_not_mem_finiteCoordinateIdeal (N : ℕ) :
    (Pi.single N 1 : ℕ → ZMod 2) ∉ finiteCoordinateIdeal N := by
  intro hmem
  have hzero : (1 : ZMod 2) = 0 := by
    simpa only [RingHom.mem_ker, Pi.evalRingHom_apply, Pi.single_eq_same] using
      finiteCoordinateIdeal_le_eval_ker N hmem
  let : Fact (1 < (2 : ℕ)) := ⟨Nat.lt_succ_self 1⟩
  exact one_ne_zero hzero

private theorem finiteCoordinateIdeal_lt_succ (N : ℕ) :
    finiteCoordinateIdeal N < finiteCoordinateIdeal (N + 1) := by
  refine lt_iff_le_not_ge.mpr ⟨finiteCoordinateIdeal_monotone (Nat.le_succ N), ?_⟩
  intro hle
  apply coordinateUnit_not_mem_finiteCoordinateIdeal N
  apply hle
  exact Ideal.subset_span ⟨N, Nat.lt_succ_self N, rfl⟩

/-- The ring of binary-valued functions on the natural numbers is not Noetherian. -/
private theorem binary_function_ring_not_noetherian :
    ¬ IsNoetherianRing (ℕ → ZMod 2) := by
  intro hnoeth
  let f : ℕ →o Ideal (ℕ → ZMod 2) :=
    ⟨finiteCoordinateIdeal, finiteCoordinateIdeal_monotone⟩
  obtain ⟨N, hN⟩ := monotone_stabilizes_iff_noetherian.mpr hnoeth f
  have hstep : finiteCoordinateIdeal N = finiteCoordinateIdeal (N + 1) :=
    hN (N + 1) (Nat.le_succ N)
  exact (ne_of_lt (finiteCoordinateIdeal_lt_succ N)) hstep

/-- Every Hankel quotient over the binary-valued function ring on the
natural numbers is non-Noetherian, including in degree zero. -/
private theorem binary_function_hankel_quotient_not_noetherian (n : ℕ) :
    ¬ IsNoetherianRing (Source (ℕ → ZMod 2) n ⧸ hankelIdeal (ℕ → ZMod 2) n) := by
  intro hQ
  exact binary_function_ring_not_noetherian
    ((quotient_isNoetherianRing_iff (ℕ → ZMod 2) n).mp hQ)


end ToricIdealsTest.RationalNormalCurve
