module

public import ToricIdeals.NumberTheory.FrobeniusNumber

/-!
# Zero, even, and numerical-semigroup arithmetic steps

The zero case checks the degenerate step. The submonoid generated by `4` and `6`
has finite relative gaps but infinite full complement, while the submonoid generated
by `2` and `3` has the single gap `1`. The last example reuses Mathlib's Frobenius theorem.
-/

@[expose] public section

example : Nat.setGcd ((⊥ : AddSubmonoid ℕ) : Set ℕ) = 0 ∧
    {n : ℕ | 0 ∣ n ∧ n ∉ (⊥ : AddSubmonoid ℕ)} = ∅ := by
  constructor
  · apply (Nat.setGcd_eq_iff_finite_gaps (⊥ : AddSubmonoid ℕ) 0).mpr
    simp
  · ext n
    simp

private abbrev fourSix : AddSubmonoid ℕ := AddSubmonoid.closure ({4, 6} : Set ℕ)

/-- The submonoid generated by `4` and `6` has arithmetic step `2`, a missing multiple,
and finite relative gaps, but its full complement is infinite. -/
theorem Nat.four_six_arithmetic_step :
    let S := AddSubmonoid.closure ({4, 6} : Set ℕ)
    Nat.setGcd (S : Set ℕ) = 2 ∧ {n : ℕ | 2 ∣ n ∧ n ∉ S}.Finite ∧
      ¬ ((S : Set ℕ)ᶜ).Finite ∧ 2 ∉ S := by
  have hdiv (n : ℕ) (hn : n ∈ fourSix) : 2 ∣ n := by
    obtain ⟨a, b, h⟩ := (AddSubmonoid.mem_closure_pair 4 6 n).mp hn
    simp only [smul_eq_mul] at h
    omega
  have hfour : Nat.setGcd (fourSix : Set ℕ) ∣ 4 :=
    Nat.setGcd_dvd_of_mem (AddSubmonoid.subset_closure (by simp))
  have hsix : Nat.setGcd (fourSix : Set ℕ) ∣ 6 :=
    Nat.setGcd_dvd_of_mem (AddSubmonoid.subset_closure (by simp))
  have hgcd : Nat.setGcd (fourSix : Set ℕ) = 2 :=
    Nat.dvd_antisymm ((Nat.dvd_add_iff_right hfour).mpr hsix)
      (Nat.dvd_setGcd_iff.mpr hdiv)
  refine ⟨hgcd, ((Nat.setGcd_eq_iff_finite_gaps fourSix 2).mp hgcd).2, ?_, ?_⟩
  · intro hfull
    have hone : Nat.setGcd (fourSix : Set ℕ) = 1 :=
      (Nat.setGcd_eq_iff_finite_gaps fourSix 1).mpr
        ⟨fun n _ ↦ one_dvd n, hfull.subset (by
          intro n hn
          exact hn.2)⟩
    omega
  · intro htwo
    obtain ⟨a, b, h⟩ := (AddSubmonoid.mem_closure_pair 4 6 2).mp htwo
    simp only [smul_eq_mul] at h
    omega

private abbrev twoThree : AddSubmonoid ℕ := AddSubmonoid.closure ({2, 3} : Set ℕ)

example : Nat.setGcd (twoThree : Set ℕ) = 1 ∧
    {n : ℕ | 1 ∣ n ∧ n ∉ twoThree} = {1} := by
  have hf : FrobeniusNumber 1 ({2, 3} : Set ℕ) := by
    simpa using frobeniusNumber_pair (m := 2) (n := 3) (by decide) (by decide) (by decide)
  have hcriterion := frobeniusNumber_iff.mp hf
  have hgap : {n : ℕ | 1 ∣ n ∧ n ∉ twoThree} = {1} := by
    ext n
    change (1 ∣ n ∧ n ∉ twoThree) ↔ n = 1
    simp only [one_dvd, true_and]
    constructor
    · intro hn
      have hnzero : n ≠ 0 := by
        intro h
        subst n
        exact hn (AddSubmonoid.zero_mem _)
      have hnle : n ≤ 1 := by
        by_contra h
        exact hn (hcriterion.2 n (by omega))
      omega
    · rintro rfl
      exact hcriterion.1
  refine ⟨(Nat.setGcd_eq_iff_finite_gaps twoThree 1).mpr ⟨fun n _ ↦ one_dvd n, ?_⟩, hgap⟩
  rw [hgap]
  exact Set.finite_singleton 1
