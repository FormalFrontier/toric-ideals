module

public import ToricIdeals.Polynomial.MonomialFinite

/-!
# A noncoprime finite monomial extension

For exponents `4, 6` over the commutative semiring `ℕ × ℕ`, the canonical gcd
extension is finite but its target is not the ambient polynomial ring. This
checks the inclusion-induced action and the target for a noncoprime pair over
coefficients that are neither a ring nor a domain.
-/

@[expose] public section

noncomputable section

namespace Polynomial

local notation "S" => AddSubmonoid.closure ({4, 6} : Set ℕ)
local notation "d" => Nat.setGcd (S : Set ℕ)
local notation "A" => Algebra.adjoin (ℕ × ℕ)
  (Set.range fun s : S => (X : (ℕ × ℕ)[X]) ^ (s : ℕ))
local notation "B" => Algebra.adjoin (ℕ × ℕ)
  (Set.range fun s : AddSubmonoid.multiples d => (X : (ℕ × ℕ)[X]) ^ (s : ℕ))

/-- The inclusion-induced algebra for exponents generated by `4` and `6`. -/
local instance instAlgebraClosureFourSixSetGcd : Algebra A B :=
  (Subalgebra.inclusion
    (adjoin_X_pow_le_adjoin_X_pow_setGcd (R := ℕ × ℕ) S)).toRingHom.toAlgebra

example : Module.Finite A B ∧ (X : (ℕ × ℕ)[X]) ∉ B := by
  refine ⟨moduleFinite_adjoin_X_pow_setGcd (R := ℕ × ℕ) S, ?_⟩
  have hd : d = 2 := by
    apply Nat.dvd_antisymm
    · have h4 : d ∣ 4 := Nat.setGcd_dvd_of_mem
        (AddSubmonoid.subset_closure (by simp : 4 ∈ ({4, 6} : Set ℕ)))
      have h6 : d ∣ 6 := Nat.setGcd_dvd_of_mem
        (AddSubmonoid.subset_closure (by simp : 6 ∈ ({4, 6} : Set ℕ)))
      have h := Nat.dvd_gcd h4 h6
      exact (show Nat.gcd 4 6 = 2 by decide) ▸ h
    · apply Nat.dvd_setGcd_iff.mpr
      intro n hn
      refine AddSubmonoid.closure_induction ?_ (dvd_zero 2) (fun _ _ _ _ => dvd_add) hn
      intro n hn
      rcases (show n = 4 ∨ n = 6 by simpa using hn) with rfl | rfl <;> decide
  intro hX
  have h1 : 1 ∈ AddSubmonoid.multiples d :=
    (X_pow_mem_adjoin_X_pow_iff (R := ℕ × ℕ) (AddSubmonoid.multiples d) 1).mp
      (by simpa using hX)
  obtain ⟨n, hn⟩ := (AddSubmonoid.mem_multiples_iff 1 d).mp h1
  have hdvd : d ∣ 1 := ⟨n, by simpa [nsmul_eq_mul, Nat.mul_comm] using hn.symm⟩
  rw [hd] at hdvd
  exact (by decide : ¬ (2 : ℕ) ∣ 1) hdvd

end Polynomial
